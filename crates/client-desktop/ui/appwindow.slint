import { LineEdit, ScrollView, ComboBox } from "std-widgets.slint";

// ============================================================================
// SISTEMA DE TEMAS REACTIVO (OSCURO TRUE BLACK / CLARO)
// ============================================================================
global Theme {
    in-out property <bool> dark-mode: true;

    out property <color> bg-window: root.dark-mode ? #000000 : #f1f5f9;
    out property <color> bg-panel: root.dark-mode ? #09090b : #ffffff;
    out property <color> bg-surface: root.dark-mode ? #050507 : #f8fafc;
    out property <color> bg-hover: root.dark-mode ? #18181b : #e2e8f0;
    out property <color> bg-elevated: root.dark-mode ? #18181b : #f1f5f9;
    out property <color> border-subtle: root.dark-mode ? #18181b : #e2e8f0;
    out property <color> border-strong: root.dark-mode ? #27272a : #cbd5e1;
    out property <color> text-primary: root.dark-mode ? #ffffff : #0f172a;
    out property <color> text-secondary: root.dark-mode ? #a1a1aa : #475569;
    out property <color> text-muted: root.dark-mode ? #71717a : #64748b;
    out property <color> text-faint: root.dark-mode ? #52525b : #94a3b8;
}

// ============================================================================
// COMPONENTES TÁCTICOS CON ESTILO ADAPTATIVO Y AUTO-AJUSTE DINÁMICO
// ============================================================================

component TacticalButton inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> has-icon: false;
    in property <bool> active: false;
    in property <bool> primary: false;
    in property <length> font-size: 13px;
    in property <int> h-stretch: 0;
    callback clicked;

    horizontal-stretch: root.h-stretch;
    height: 38px;
    min-width: txt.min-width + (root.has-icon ? 44px : 24px);
    border-radius: 6px;
    border-width: 1px;
    border-color: root.active ? #38bdf8 : (root.primary ? #22c55e : (touch.has-hover ? #3f3f46 : Theme.border-strong));
    background: root.active ? #0c4a6e : (root.primary ? #14532d : (touch.has-hover ? Theme.bg-hover : Theme.bg-panel));

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 7px;
        alignment: center;

        if (root.has-icon): VerticalLayout {
            alignment: center;
            Image {
                source: root.icon;
                width: 15px;
                height: 15px;
                colorize: root.active ? #ffffff : (root.primary ? #4ade80 : (touch.has-hover ? Theme.text-primary : Theme.text-secondary));
            }
        }

        txt := Text {
            text: root.text;
            color: root.active ? #ffffff : (root.primary ? #4ade80 : (touch.has-hover ? Theme.text-primary : Theme.text-secondary));
            font-size: root.font-size;
            font-weight: 700;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }
}

// Botón de eliminar rojo táctico para filas de parqueaderos
component DeleteButton inherits Rectangle {
    callback clicked;

    width: 84px;
    height: 24px;
    border-radius: 4px;
    border-width: 1px;
    border-color: del-touch.has-hover ? #ef4444 : #3f1515;
    background: del-touch.has-hover ? #450a0a : #180909;

    del-touch := TouchArea {
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        spacing: 4px;
        alignment: center;
        VerticalLayout {
            alignment: center;
            Image {
                source: @image-url("icons/trash-2.svg");
                width: 12px;
                height: 12px;
                colorize: del-touch.has-hover ? #ffffff : #f87171;
            }
        }
        Text {
            text: "ELIMINAR";
            color: del-touch.has-hover ? #ffffff : #f87171;
            font-size: 10px;
            font-weight: 800;
            vertical-alignment: center;
        }
    }
}

// Botón de acción compacto para filas del dashboard (Dar salida / Entregar)
component CompactActionButton inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> has-icon: false;
    in property <bool> positive: false;
    callback clicked;

    height: 26px;
    min-width: txt.min-width + (root.has-icon ? 32px : 18px);
    border-radius: 4px;
    border-width: 1px;
    border-color: root.positive
        ? (btn-touch.has-hover ? #22c55e : #14532d)
        : (btn-touch.has-hover ? #38bdf8 : #1e3a5f);
    background: root.positive
        ? (btn-touch.has-hover ? #14532d : #052e16)
        : (btn-touch.has-hover ? #0c4a6e : #082f49);

    btn-touch := TouchArea {
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 5px;
        alignment: center;
        if (root.has-icon): VerticalLayout {
            alignment: center;
            Image {
                source: root.icon;
                width: 12px;
                height: 12px;
                colorize: btn-touch.has-hover ? #ffffff : (root.positive ? #4ade80 : #7dd3fc);
            }
        }
        txt := Text {
            text: root.text;
            color: btn-touch.has-hover ? #ffffff : (root.positive ? #4ade80 : #7dd3fc);
            font-size: 10px;
            font-weight: 800;
            vertical-alignment: center;
        }
    }
}

// Botón hamburguesa con icono SVG Lucide (menu.svg)
component HamburgerButton inherits Rectangle {
    callback clicked;

    width: 34px;
    height: 34px;
    border-radius: 6px;
    background: hb-touch.has-hover ? Theme.bg-hover : Theme.bg-elevated;
    border-width: 1px;
    border-color: hb-touch.has-hover ? #38bdf8 : Theme.border-strong;

    hb-touch := TouchArea {
        clicked => { root.clicked(); }
    }

    Image {
        source: @image-url("icons/menu.svg");
        width: 18px;
        height: 18px;
        colorize: hb-touch.has-hover ? Theme.text-primary : Theme.text-secondary;
    }
}

// Ítem de navegación para el panel lateral izquierdo colapsable (con color por módulo e iconos Lucide SVG)
component SidebarNavItem inherits Rectangle {
    in property <image> icon;
    in property <string> shortcut;
    in property <string> label;
    in property <color> accent-color: #38bdf8;
    in property <color> accent-bg: #0c4a6e;
    in property <bool> active: false;
    in property <bool> collapsed: false;
    callback clicked;

    height: 40px;
    border-radius: 6px;
    border-width: 1px;
    border-color: root.active ? root.accent-color : (nav-touch.has-hover ? Theme.border-strong : transparent);
    background: root.active ? (Theme.dark-mode ? root.accent-bg : Theme.bg-elevated) : (nav-touch.has-hover ? Theme.bg-hover : transparent);

    nav-touch := TouchArea {
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: root.collapsed ? 0px : 12px;
        padding-right: root.collapsed ? 0px : 10px;
        spacing: 10px;
        alignment: root.collapsed ? center : space-between;

        HorizontalLayout {
            spacing: 10px;
            alignment: root.collapsed ? center : start;

            VerticalLayout {
                alignment: center;
                Image {
                    source: root.icon;
                    width: 18px;
                    height: 18px;
                    colorize: root.accent-color;
                }
            }

            if (!root.collapsed): Text {
                text: root.label;
                color: root.active ? Theme.text-primary : (nav-touch.has-hover ? Theme.text-primary : Theme.text-secondary);
                font-size: 12px;
                font-weight: 800;
                vertical-alignment: center;
                overflow: elide;
            }
        }

        if (!root.collapsed): VerticalLayout {
            alignment: center;
            Rectangle {
                width: 26px;
                height: 20px;
                border-radius: 4px;
                background: root.active ? Theme.bg-panel : Theme.bg-elevated;
                border-width: 1px;
                border-color: root.active ? root.accent-color : Theme.border-strong;

                Text {
                    text: root.shortcut;
                    color: root.active ? root.accent-color : Theme.text-muted;
                    font-size: 9px;
                    font-weight: 800;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }
}

// Estructuras de datos para Slint
export struct ActiveVisitItem {
    id: string,
    visitor_name: string,
    document: string,
    destination: string,
    entry_time: string,
    access_type: string,
}

export struct PendingPackageItem {
    id: string,
    destination: string,
    recipient: string,
    carrier: string,
    description: string,
    received_time: string,
}

export struct ResidentItem {
    id: string,
    full_name: string,
    document: string,
    unit_label: string,
    role: string,
    mobile: string,
    email: string,
}

export struct ParkingPickerItem {
    code: string,
    spot_type: string,
    display_name: string,
}

export struct UnitItem {
    id: string,
    tower: string,
    unit_number: string,
    unit_type: string,
    intercom: string,
    mobile: string,
    landline: string,
    parking: string,
}

export struct TowerItem {
    id: string,
    name: string,
    unit_count: int,
}

// ============================================================================
// VENTANA PRINCIPAL — MAMORI BLACK EDITION
// ============================================================================
export component AppWindow inherits Window {
    title: "MAMORI — Terminal de Portería (Black Edition)";
    preferred-width: 1200px;
    preferred-height: 780px;
    min-width: 1000px;
    min-height: 700px;
    background: Theme.bg-window;

    in-out property <bool> is-authenticated: false;
    in-out property <string> login-username: "";
    in-out property <string> login-password: "";
    in-out property <string> login-error: "";
    in-out property <string> active-module: "home";
    in-out property <string> current-view-title: "DASHBOARD";
    property <color> current-module-color:
        root.active-module == "visita" ? #60a5fa :
        root.active-module == "vehiculo" ? #c084fc :
        root.active-module == "paquete" ? #fbbf24 :
        root.active-module == "residentes" ? #2dd4bf :
        root.active-module == "minuta" ? #fb7185 :
        root.active-module == "unidades" ? #4ade80 :
        root.active-module == "config" ? #94a3b8 : #38bdf8;
    in-out property <bool> sidebar-collapsed: false;
    in-out property <string> current-user-name: "Cristian Ricardo Rojas";
    in-out property <string> current-user-role: "Portería";
    in-out property <string> status-text: "DASHBOARD";
    in-out property <[ActiveVisitItem]> active-visits: [];
    in-out property <[PendingPackageItem]> pending-packages: [];
    in-out property <[ResidentItem]> residents: [];
    in-out property <string> resident-search-query: "";
    in-out property <bool> show-resident-drawer: false;
    in-out property <string> form-resident-doc: "";
    in-out property <string> form-resident-name: "";
    in-out property <string> form-resident-unit: "";
    in-out property <string> form-resident-role: "Propietario";
    in-out property <string> form-resident-mobile: "";
    in-out property <string> form-resident-email: "";
    in-out property <string> selected-tower: "Torre 1";
    in-out property <bool> show-drawer: false;
    in-out property <bool> show-parking-modal: false;
    in-out property <bool> show-parking-picker: false;
    in-out property <string> parking-search-query: "";
    in-out property <[ParkingPickerItem]> filtered-parking-options: [];

    // Campos del formulario inmueble
    in-out property <string> form-unit-number: "";
    in-out property <string> form-unit-type: "Apartamento";
    in-out property <string> form-intercom: "";
    in-out property <string> form-mobile: "";
    in-out property <string> form-landline: "";

    // Campos para crear nuevo parqueadero
    in-out property <string> form-parking-code: "";
    in-out property <string> form-parking-type: "Carro";

    // Opciones disponibles para los ComboBox
    in-out property <[string]> available-parking-options: [
        "-- Seleccionar parqueadero --",
        "P-104 (Carro)",
        "P-105 (Carro)",
        "P-106 (Carro)",
        "P-107 (Carro)",
        "M-01 (Moto)",
        "M-02 (Moto)",
        "M-03 (Moto)",
        "M-04 (Moto)"
    ];

    // Lista dinámica de parqueaderos asignados al inmueble actual
    in-out property <[string]> selected-parking-list: [];
    in-out property <string> new-parking-selector-value: "-- Seleccionar parqueadero --";

    // Listas reactivas
    in-out property <[TowerItem]> towers: [
        { id: "t1", name: "Torre 1", unit_count: 24 },
        { id: "t2", name: "Torre 2", unit_count: 24 },
        { id: "t3", name: "Bloque Norte", unit_count: 16 },
        { id: "t4", name: "Manzana A (Casas)", unit_count: 12 },
    ];

    in-out property <[UnitItem]> units: [
        { id: "u1", tower: "Torre 1", unit_number: "Apto 101", unit_type: "Apartamento", intercom: "Ext. 101", mobile: "300 123 4567", landline: "(604) 444 0001", parking: "P-101" },
        { id: "u2", tower: "Torre 1", unit_number: "Apto 102", unit_type: "Apartamento", intercom: "Sin citófono", mobile: "315 987 6543", landline: "—", parking: "P-102, P-102B" },
        { id: "u3", tower: "Torre 1", unit_number: "Apto 103", unit_type: "Apartamento", intercom: "Ext. 103", mobile: "311 555 8899", landline: "—", parking: "Sin celda" },
        { id: "u4", tower: "Torre 1", unit_number: "Apto 201", unit_type: "Apartamento", intercom: "Ext. 201", mobile: "310 444 3322", landline: "(604) 444 0004", parking: "P-201" },
        { id: "u5", tower: "Torre 1", unit_number: "Apto 202", unit_type: "Apartamento", intercom: "Ext. 202", mobile: "318 777 6655", landline: "—", parking: "P-202" },
        { id: "u6", tower: "Torre 1", unit_number: "Apto 203", unit_type: "Apartamento", intercom: "Sin citófono", mobile: "301 222 1100", landline: "—", parking: "P-203" },
    ];

    callback attempt-login();
    callback logout();
    callback quick-action(string);
    callback select-tower(string);
    callback register-visit-exit(int);
    callback deliver-package(int);
    callback open-resident-drawer();
    callback cancel-resident-drawer();
    callback search-residents(string);
    callback save-resident();
    callback open-drawer();
    callback cancel-drawer();
    callback save-unit();
    callback open-parking-picker();
    callback close-parking-picker();
    callback search-parking(string);
    callback pick-parking(string);
    callback remove-parking-selection(int);
    callback create-new-parking();

    forward-focus: key-handler;

    key-handler := FocusScope {
        key-pressed(event) => {
            if (!root.is-authenticated) {
                return reject;
            }
            if (event.text == Key.Escape) {
                if (root.show-parking-modal) {
                    root.show-parking-modal = false;
                    return accept;
                }
                if (root.show-parking-picker) {
                    root.close-parking-picker();
                    return accept;
                }
                if (root.show-resident-drawer) {
                    root.cancel-resident-drawer();
                    return accept;
                }
                if (root.show-drawer) {
                    root.cancel-drawer();
                    return accept;
                }
            }
            if (event.text == Key.F1) { root.quick-action("home"); return accept; }
            if (event.text == Key.F2) { root.quick-action("visita"); return accept; }
            if (event.text == Key.F3) { root.quick-action("vehiculo"); return accept; }
            if (event.text == Key.F4) { root.quick-action("paquete"); return accept; }
            if (event.text == Key.F5) { root.quick-action("residentes"); return accept; }
            if (event.text == Key.F6) { root.quick-action("minuta"); return accept; }
            if (event.text == Key.F7) { root.quick-action("unidades"); return accept; }
            if (event.text == Key.F8) { root.quick-action("config"); return accept; }
            return reject;
        }

        // ====================================================================
        // CAPA BASE: SIDEBAR IZQUIERDO FULL-HEIGHT + ÁREA DE TRABAJO DERECHA
        // ====================================================================
        HorizontalLayout {
            padding: 0px;
            spacing: 0px;

            // 1. PANEL LATERAL IZQUIERDO FULL-HEIGHT (MENÚ PRINCIPAL)
            Rectangle {
                width: root.sidebar-collapsed ? 64px : 240px;
                animate width { duration: 180ms; easing: ease-out; }
                clip: true;
                background: Theme.bg-panel;

                VerticalLayout {
                    padding: 0px;
                    spacing: 0px;

                    // CABECERA DEL SIDEBAR: LOGO MAMORI + MENÚ HAMBURGUESA
                    Rectangle {
                        height: 62px;
                        background: Theme.bg-panel;

                        HorizontalLayout {
                            padding-left: root.sidebar-collapsed ? 0px : 16px;
                            padding-right: root.sidebar-collapsed ? 0px : 12px;
                            alignment: root.sidebar-collapsed ? center : space-between;

                            if (!root.sidebar-collapsed): HorizontalLayout {
                                spacing: 8px;
                                VerticalLayout {
                                    alignment: center;
                                    Image {
                                        source: @image-url("icons/shield.svg");
                                        width: 20px;
                                        height: 20px;
                                        colorize: #38bdf8;
                                    }
                                }
                                Text {
                                    text: "MAMORI";
                                    color: Theme.text-primary;
                                    font-size: 20px;
                                    font-weight: 900;
                                    vertical-alignment: center;
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                HamburgerButton {
                                    clicked => { root.sidebar-collapsed = !root.sidebar-collapsed; }
                                }
                            }
                        }
                    }

                    Rectangle { height: 1px; background: Theme.border-subtle; }

                    // LISTA DE MÓDULOS DE NAVEGACIÓN (ORDEN OFICIAL)
                    VerticalLayout {
                        vertical-stretch: 1;
                        padding: 10px;
                        spacing: 6px;

                        SidebarNavItem {
                            icon: @image-url("icons/home.svg");
                            shortcut: "F1";
                            label: "HOME";
                            accent-color: #38bdf8;
                            accent-bg: #0c4a6e;
                            active: root.active-module == "home";
                            collapsed: root.sidebar-collapsed;
                            clicked => { root.quick-action("home"); }
                        }
                        SidebarNavItem {
                            icon: @image-url("icons/users.svg");
                            shortcut: "F2";
                            label: "VISITAS";
                            accent-color: #60a5fa;
                            accent-bg: #1e3a8a;
                            active: root.active-module == "visita";
                            collapsed: root.sidebar-collapsed;
                            clicked => { root.quick-action("visita"); }
                        }
                        SidebarNavItem {
                            icon: @image-url("icons/car.svg");
                            shortcut: "F3";
                            label: "VEHÍCULOS";
                            accent-color: #c084fc;
                            accent-bg: #3b0764;
                            active: root.active-module == "vehiculo";
                            collapsed: root.sidebar-collapsed;
                            clicked => { root.quick-action("vehiculo"); }
                        }
                        SidebarNavItem {
                            icon: @image-url("icons/package.svg");
                            shortcut: "F4";
                            label: "PAQUETERÍA";
                            accent-color: #fbbf24;
                            accent-bg: #451a03;
                            active: root.active-module == "paquete";
                            collapsed: root.sidebar-collapsed;
                            clicked => { root.quick-action("paquete"); }
                        }
                        SidebarNavItem {
                            icon: @image-url("icons/id-card.svg");
                            shortcut: "F5";
                            label: "RESIDENTES";
                            accent-color: #2dd4bf;
                            accent-bg: #134e4a;
                            active: root.active-module == "residentes";
                            collapsed: root.sidebar-collapsed;
                            clicked => { root.quick-action("residentes"); }
                        }
                        SidebarNavItem {
                            icon: @image-url("icons/clipboard-list.svg");
                            shortcut: "F6";
                            label: "MINUTA & NOVEDADES";
                            accent-color: #fb7185;
                            accent-bg: #4c0519;
                            active: root.active-module == "minuta";
                            collapsed: root.sidebar-collapsed;
                            clicked => { root.quick-action("minuta"); }
                        }
                        SidebarNavItem {
                            icon: @image-url("icons/building-2.svg");
                            shortcut: "F7";
                            label: "UNIDADES & PREDIOS";
                            accent-color: #4ade80;
                            accent-bg: #052e16;
                            active: root.active-module == "unidades";
                            collapsed: root.sidebar-collapsed;
                            clicked => { root.quick-action("unidades"); }
                        }

                        Rectangle { vertical-stretch: 1; }

                        Rectangle { height: 1px; background: Theme.border-subtle; }

                        SidebarNavItem {
                            icon: @image-url("icons/settings.svg");
                            shortcut: "F8";
                            label: "CONFIGURACIÓN";
                            accent-color: #94a3b8;
                            accent-bg: #1e293b;
                            active: root.active-module == "config";
                            collapsed: root.sidebar-collapsed;
                            clicked => { root.quick-action("config"); }
                        }

                        if (!root.sidebar-collapsed): Text {
                            text: "MAMORI PORTERÍA v0.1.0";
                            color: Theme.text-faint;
                            font-size: 10px;
                            font-weight: 800;
                            horizontal-alignment: center;
                        }
                    }
                }
            }

            // SEPARADOR VERTICAL DEL SIDEBAR
            Rectangle {
                width: 1px;
                background: Theme.border-subtle;
            }

            // 2. ÁREA DE TRABAJO PRINCIPAL (DERECHA)
            VerticalLayout {
                horizontal-stretch: 1;
                vertical-stretch: 1;
                padding: 14px;
                spacing: 12px;

                // BARRA SUPERIOR DE CONTEXTO, ESTADO EN VIVO Y USUARIO LOGUEADO
                Rectangle {
                    height: 52px;
                    background: Theme.bg-panel;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: Theme.border-subtle;

                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        alignment: space-between;

                        // Vista actual y estado en vivo (izquierda)
                        HorizontalLayout {
                            spacing: 10px;
                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 10px;
                                    height: 10px;
                                    border-radius: 5px;
                                    background: root.current-module-color;
                                }
                            }
                            Text {
                                text: root.current-view-title;
                                color: root.current-module-color;
                                font-size: 13px;
                                font-weight: 900;
                                vertical-alignment: center;
                            }
                            if (root.status-text != root.current-view-title): Text {
                                text: "|  " + root.status-text;
                                color: Theme.text-muted;
                                font-size: 12px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }

                        // Usuario logueado (derecha superior)
                        HorizontalLayout {
                            spacing: 10px;
                            alignment: end;

                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 1px;
                                    height: 24px;
                                    background: Theme.border-strong;
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 30px;
                                    height: 30px;
                                    border-radius: 15px;
                                    background: Theme.bg-elevated;
                                    border-width: 1px;
                                    border-color: Theme.border-strong;

                                    Image {
                                        source: @image-url("icons/user.svg");
                                        width: 15px;
                                        height: 15px;
                                        colorize: #38bdf8;
                                    }
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                spacing: 1px;
                                Text {
                                    text: root.current-user-name;
                                    color: Theme.text-primary;
                                    font-size: 12px;
                                    font-weight: 800;
                                }
                                Text {
                                    text: root.current-user-role;
                                    color: Theme.text-muted;
                                    font-size: 10px;
                                    font-weight: 600;
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 112px;
                                    height: 28px;
                                    border-radius: 6px;
                                    border-width: 1px;
                                    border-color: logout-touch.has-hover ? #ef4444 : #3f1515;
                                    background: logout-touch.has-hover ? #450a0a : (Theme.dark-mode ? #180909 : #fef2f2);

                                    logout-touch := TouchArea {
                                        clicked => { root.logout(); }
                                    }

                                    HorizontalLayout {
                                        spacing: 5px;
                                        alignment: center;
                                        VerticalLayout {
                                            alignment: center;
                                            Image {
                                                source: @image-url("icons/log-out.svg");
                                                width: 12px;
                                                height: 12px;
                                                colorize: logout-touch.has-hover ? #ffffff : #ef4444;
                                            }
                                        }
                                        Text {
                                            text: "CERRAR SESIÓN";
                                            color: logout-touch.has-hover ? #ffffff : #ef4444;
                                            font-size: 10px;
                                            font-weight: 800;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // ================================================================
                // 3A. VISTA HOME: DASHBOARD OPERATIVO DE PORTERÍA
                // ================================================================
                if (root.active-module == "home"): VerticalLayout {
                vertical-stretch: 1;
                spacing: 12px;

                // FILA SUPERIOR: TARJETAS DE RESUMEN OPERATIVO (KPIs)
                HorizontalLayout {
                    vertical-stretch: 0;
                    spacing: 12px;
                    height: 84px;

                    // KPI 1: Visitas dentro de la unidad
                    Rectangle {
                        horizontal-stretch: 1;
                        background: Theme.bg-panel;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: Theme.border-subtle;

                        VerticalLayout {
                            padding: 14px;
                            spacing: 4px;
                            HorizontalLayout {
                                alignment: space-between;
                                Text { text: "VISITAS DENTRO DE LA UNIDAD"; color: Theme.text-muted; font-size: 11px; font-weight: 800; vertical-alignment: center; }
                                Image { source: @image-url("icons/users.svg"); width: 16px; height: 16px; colorize: #38bdf8; }
                            }
                            HorizontalLayout {
                                spacing: 10px;
                                alignment: start;
                                Text { text: root.active-visits.length; color: Theme.text-primary; font-size: 26px; font-weight: 900; vertical-alignment: bottom; }
                                Text { text: "activas en este momento"; color: #38bdf8; font-size: 11px; font-weight: 600; vertical-alignment: bottom; }
                            }
                        }
                    }

                    // KPI 2: Paquetería pendiente
                    Rectangle {
                        horizontal-stretch: 1;
                        background: Theme.bg-panel;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: Theme.border-subtle;

                        VerticalLayout {
                            padding: 14px;
                            spacing: 4px;
                            HorizontalLayout {
                                alignment: space-between;
                                Text { text: "PAQUETERÍA PENDIENTE"; color: Theme.text-muted; font-size: 11px; font-weight: 800; vertical-alignment: center; }
                                Image { source: @image-url("icons/package.svg"); width: 16px; height: 16px; colorize: #f59e0b; }
                            }
                            HorizontalLayout {
                                spacing: 10px;
                                alignment: start;
                                Text { text: root.pending-packages.length; color: Theme.text-primary; font-size: 26px; font-weight: 900; vertical-alignment: bottom; }
                                Text { text: "en casillero de portería"; color: #fbbf24; font-size: 11px; font-weight: 600; vertical-alignment: bottom; }
                            }
                        }
                    }

                    // KPI 3: Unidades registradas
                    Rectangle {
                        horizontal-stretch: 1;
                        background: Theme.bg-panel;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: Theme.border-subtle;

                        VerticalLayout {
                            padding: 14px;
                            spacing: 4px;
                            HorizontalLayout {
                                alignment: space-between;
                                Text { text: "UNIDADES REGISTRADAS"; color: Theme.text-muted; font-size: 11px; font-weight: 800; vertical-alignment: center; }
                                Image { source: @image-url("icons/building-2.svg"); width: 16px; height: 16px; colorize: #22c55e; }
                            }
                            HorizontalLayout {
                                spacing: 10px;
                                alignment: start;
                                Text { text: root.units.length; color: Theme.text-primary; font-size: 26px; font-weight: 900; vertical-alignment: bottom; }
                                Text { text: "predios en directorio"; color: #4ade80; font-size: 11px; font-weight: 600; vertical-alignment: bottom; }
                            }
                        }
                    }
                }

                // PANEL PRINCIPAL DIVIDIDO: VISITAS ACTIVAS | PAQUETERÍA PENDIENTE
                HorizontalLayout {
                    vertical-stretch: 1;
                    spacing: 12px;

                    // COLUMNA IZQUIERDA: VISITAS DENTRO DE LA UNIDAD
                    Rectangle {
                        horizontal-stretch: 1;
                        background: Theme.bg-panel;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: Theme.border-subtle;

                        VerticalLayout {
                            padding: 16px;
                            spacing: 10px;

                            HorizontalLayout {
                                vertical-stretch: 0;
                                alignment: space-between;
                                VerticalLayout {
                                    spacing: 2px;
                                    Text {
                                        text: "VISITAS DENTRO DE LA UNIDAD";
                                        color: Theme.text-primary;
                                        font-size: 14px;
                                        font-weight: 900;
                                    }
                                    Text {
                                        text: "Personas actualmente dentro de la copropiedad sin registro de salida";
                                        color: Theme.text-muted;
                                        font-size: 11px;
                                        font-weight: 500;
                                    }
                                }
                                CompactActionButton {
                                    text: "IR A VISITAS";
                                    icon: @image-url("icons/arrow-right.svg");
                                    has-icon: true;
                                    clicked => { root.quick-action("visita"); }
                                }
                            }

                            Rectangle { height: 1px; background: Theme.border-subtle; }

                            // Cabecera de tabla
                            Rectangle {
                                height: 30px;
                                background: Theme.bg-surface;
                                border-radius: 4px;
                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    spacing: 8px;
                                    Text { text: "VISITANTE"; horizontal-stretch: 2; color: Theme.text-muted; font-size: 10px; font-weight: 800; vertical-alignment: center; }
                                    Text { text: "DESTINO"; horizontal-stretch: 2; color: Theme.text-muted; font-size: 10px; font-weight: 800; vertical-alignment: center; }
                                    Text { text: "INGRESO"; width: 58px; color: Theme.text-muted; font-size: 10px; font-weight: 800; vertical-alignment: center; }
                                    Text { text: "ACCIÓN"; width: 106px; color: Theme.text-muted; font-size: 10px; font-weight: 800; vertical-alignment: center; horizontal-alignment: right; }
                                }
                            }

                            if (root.active-visits.length == 0): Rectangle {
                                vertical-stretch: 1;
                                background: Theme.bg-surface;
                                border-radius: 6px;
                                border-width: 1px;
                                border-color: Theme.border-subtle;
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 4px;
                                    Text {
                                        text: "No hay visitantes dentro de la unidad";
                                        color: Theme.text-secondary;
                                        font-size: 13px;
                                        font-weight: 700;
                                        horizontal-alignment: center;
                                    }
                                    Text {
                                        text: "Todas las visitas registradas ya completaron su salida";
                                        color: Theme.text-faint;
                                        font-size: 11px;
                                        horizontal-alignment: center;
                                    }
                                }
                            }

                            if (root.active-visits.length > 0): ScrollView {
                                vertical-stretch: 1;
                                VerticalLayout {
                                    alignment: start;
                                    spacing: 6px;
                                    for visit[idx] in root.active-visits: Rectangle {
                                        height: 54px;
                                        background: Theme.bg-surface;
                                        border-radius: 6px;
                                        border-width: 1px;
                                        border-color: Theme.border-subtle;

                                        HorizontalLayout {
                                            padding-left: 12px;
                                            padding-right: 12px;
                                            spacing: 8px;

                                            VerticalLayout {
                                                horizontal-stretch: 2;
                                                alignment: center;
                                                spacing: 2px;
                                                Text { text: visit.visitor-name; color: Theme.text-primary; font-size: 12px; font-weight: 800; }
                                                Text { text: visit.document + " • " + visit.access-type; color: Theme.text-muted; font-size: 10px; font-weight: 600; }
                                            }

                                            VerticalLayout {
                                                horizontal-stretch: 2;
                                                alignment: center;
                                                Text { text: visit.destination; color: #38bdf8; font-size: 12px; font-weight: 700; }
                                            }

                                            Text {
                                                text: visit.entry-time;
                                                width: 58px;
                                                color: Theme.text-primary;
                                                font-size: 12px;
                                                font-weight: 700;
                                                vertical-alignment: center;
                                            }

                                            VerticalLayout {
                                                width: 106px;
                                                alignment: center;
                                                CompactActionButton {
                                                    text: "DAR SALIDA";
                                                    icon: @image-url("icons/log-out.svg");
                                                    has-icon: true;
                                                    clicked => { root.register-visit-exit(idx); }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // COLUMNA DERECHA: PAQUETERÍA PENDIENTE POR ENTREGAR
                    Rectangle {
                        horizontal-stretch: 1;
                        background: Theme.bg-panel;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: Theme.border-subtle;

                        VerticalLayout {
                            padding: 16px;
                            spacing: 10px;

                            HorizontalLayout {
                                vertical-stretch: 0;
                                alignment: space-between;
                                VerticalLayout {
                                    spacing: 2px;
                                    Text {
                                        text: "PAQUETERÍA PENDIENTE POR ENTREGAR";
                                        color: Theme.text-primary;
                                        font-size: 14px;
                                        font-weight: 900;
                                    }
                                    Text {
                                        text: "Encomiendas recibidas en garita esperando reclamo del residente";
                                        color: Theme.text-muted;
                                        font-size: 11px;
                                        font-weight: 500;
                                    }
                                }
                                CompactActionButton {
                                    text: "IR A PAQUETERÍA";
                                    icon: @image-url("icons/arrow-right.svg");
                                    has-icon: true;
                                    clicked => { root.quick-action("paquete"); }
                                }
                            }

                            Rectangle { height: 1px; background: Theme.border-subtle; }

                            // Cabecera de tabla
                            Rectangle {
                                height: 30px;
                                background: Theme.bg-surface;
                                border-radius: 4px;
                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    spacing: 8px;
                                    Text { text: "DESTINO / RESIDENTE"; horizontal-stretch: 2; color: Theme.text-muted; font-size: 10px; font-weight: 800; vertical-alignment: center; }
                                    Text { text: "EMPRESA / DETALLE"; horizontal-stretch: 2; color: Theme.text-muted; font-size: 10px; font-weight: 800; vertical-alignment: center; }
                                    Text { text: "RECIBIDO"; width: 58px; color: Theme.text-muted; font-size: 10px; font-weight: 800; vertical-alignment: center; }
                                    Text { text: "ACCIÓN"; width: 106px; color: Theme.text-muted; font-size: 10px; font-weight: 800; vertical-alignment: center; horizontal-alignment: right; }
                                }
                            }

                            if (root.pending-packages.length == 0): Rectangle {
                                vertical-stretch: 1;
                                background: Theme.bg-surface;
                                border-radius: 6px;
                                border-width: 1px;
                                border-color: Theme.border-subtle;
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 4px;
                                    Text {
                                        text: "Sin paquetería pendiente por entregar";
                                        color: Theme.text-secondary;
                                        font-size: 13px;
                                        font-weight: 700;
                                        horizontal-alignment: center;
                                    }
                                    Text {
                                        text: "El casillero de portería se encuentra al día";
                                        color: Theme.text-faint;
                                        font-size: 11px;
                                        horizontal-alignment: center;
                                    }
                                }
                            }

                            if (root.pending-packages.length > 0): ScrollView {
                                vertical-stretch: 1;
                                VerticalLayout {
                                    alignment: start;
                                    spacing: 6px;
                                    for pkg[idx] in root.pending-packages: Rectangle {
                                        height: 54px;
                                        background: Theme.bg-surface;
                                        border-radius: 6px;
                                        border-width: 1px;
                                        border-color: Theme.border-subtle;

                                        HorizontalLayout {
                                            padding-left: 12px;
                                            padding-right: 12px;
                                            spacing: 8px;

                                            VerticalLayout {
                                                horizontal-stretch: 2;
                                                alignment: center;
                                                spacing: 2px;
                                                Text { text: pkg.destination; color: #fbbf24; font-size: 12px; font-weight: 800; }
                                                Text { text: pkg.recipient; color: Theme.text-secondary; font-size: 10px; font-weight: 600; }
                                            }

                                            VerticalLayout {
                                                horizontal-stretch: 2;
                                                alignment: center;
                                                spacing: 2px;
                                                Text { text: pkg.carrier; color: Theme.text-primary; font-size: 12px; font-weight: 700; }
                                                Text { text: pkg.description; color: Theme.text-muted; font-size: 10px; font-weight: 600; }
                                            }

                                            Text {
                                                text: pkg.received-time;
                                                width: 58px;
                                                color: Theme.text-primary;
                                                font-size: 12px;
                                                font-weight: 700;
                                                vertical-alignment: center;
                                            }

                                            VerticalLayout {
                                                width: 106px;
                                                alignment: center;
                                                CompactActionButton {
                                                    text: "ENTREGAR";
                                                    icon: @image-url("icons/check.svg");
                                                    has-icon: true;
                                                    positive: true;
                                                    clicked => { root.deliver-package(idx); }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // ================================================================
            // 3B. CUERPO PRINCIPAL: GESTIÓN DE UNIDADES
            // ================================================================
            if (root.active-module == "unidades"): HorizontalLayout {
                vertical-stretch: 1;
                spacing: 12px;

                // PANEL IZQUIERDO: TORRES Y PARQUEADEROS
                Rectangle {
                    width: 270px;
                    background: Theme.bg-panel;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: Theme.border-subtle;

                    VerticalLayout {
                        padding: 14px;
                        spacing: 10px;

                        HorizontalLayout {
                            spacing: 6px;
                            alignment: start;
                            VerticalLayout {
                                alignment: center;
                                Image { source: @image-url("icons/building-2.svg"); width: 14px; height: 14px; colorize: #71717a; }
                            }
                            Text {
                                text: "TORRES / BLOQUES";
                                color: Theme.text-muted;
                                font-size: 12px;
                                font-weight: 800;
                                vertical-alignment: center;
                            }
                        }

                        Rectangle { height: 1px; background: Theme.border-subtle; }

                        for tower in root.towers: Rectangle {
                            height: 48px;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: root.selected-tower == tower.name ? #38bdf8 : #18181b;
                            background: root.selected-tower == tower.name ? #111827 : (tower-touch.has-hover ? #141417 : #050507);

                            tower-touch := TouchArea {
                                clicked => {
                                    root.selected-tower = tower.name;
                                    root.select-tower(tower.name);
                                }
                            }

                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                alignment: space-between;

                                Text {
                                    text: tower.name;
                                    color: root.selected-tower == tower.name ? #38bdf8 : #f4f4f5;
                                    font-size: 14px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }

                                Rectangle {
                                    width: 68px;
                                    height: 22px;
                                    border-radius: 11px;
                                    background: Theme.border-subtle;
                                    y: 13px;

                                    Text {
                                        text: tower.unit_count + " aptos";
                                        color: Theme.text-secondary;
                                        font-size: 11px;
                                        font-weight: 600;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }

                        Rectangle { height: 6px; }

                        TacticalButton {
                            text: "NUEVA TORRE / BLOQUE";
                            icon: @image-url("icons/plus.svg");
                            has-icon: true;
                            h-stretch: 1;
                            clicked => {
                                root.status-text = "Iniciando creación de nueva torre...";
                            }
                        }

                        Rectangle { height: 10px; }
                        Rectangle { height: 1px; background: Theme.border-subtle; }

                        // SECCIÓN RÁPIDA: PARQUEADEROS
                        Text {
                            text: "PARQUEADEROS COPROPIEDAD";
                            color: Theme.text-muted;
                            font-size: 11px;
                            font-weight: 800;
                        }

                        TacticalButton {
                            text: "CREAR PARQUEADERO";
                            icon: @image-url("icons/car.svg");
                            has-icon: true;
                            h-stretch: 1;
                            clicked => {
                                root.show-parking-modal = true;
                            }
                        }
                    }
                }

                // PANEL DERECHO: DIRECTORIO DE INMUEBLES
                Rectangle {
                    background: Theme.bg-panel;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: Theme.border-subtle;

                    VerticalLayout {
                        padding: 16px;
                        spacing: 12px;

                        HorizontalLayout {
                            alignment: space-between;

                            HorizontalLayout {
                                spacing: 12px;
                                Text {
                                    text: root.selected-tower;
                                    color: Theme.text-primary;
                                    font-size: 18px;
                                    font-weight: 800;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: "•  Directorio de Inmuebles Registrados";
                                    color: Theme.text-muted;
                                    font-size: 13px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                            }

                            TacticalButton {
                                text: "NUEVO INMUEBLE";
                                icon: @image-url("icons/plus.svg");
                                has-icon: true;
                                primary: true;
                                clicked => {
                                    root.open-drawer();
                                }
                            }
                        }

                        Rectangle { height: 1px; background: Theme.border-subtle; }

                        // TABLA DE INMUEBLES
                        VerticalLayout {
                            spacing: 3px;

                            Rectangle {
                                height: 36px;
                                background: #000000;
                                border-radius: 4px;
                                border-width: 1px;
                                border-color: Theme.border-subtle;

                                HorizontalLayout {
                                    padding-left: 14px;
                                    padding-right: 14px;

                                    Text { text: "INMUEBLE"; width: 110px; color: Theme.text-muted; font-size: 11px; font-weight: 800; vertical-alignment: center; }
                                    Text { text: "TIPO"; width: 120px; color: Theme.text-muted; font-size: 11px; font-weight: 800; vertical-alignment: center; }
                                    Text { text: "CITÓFONO / EXT."; width: 140px; color: Theme.text-muted; font-size: 11px; font-weight: 800; vertical-alignment: center; }
                                    Text { text: "CELULAR"; width: 140px; color: Theme.text-muted; font-size: 11px; font-weight: 800; vertical-alignment: center; }
                                    Text { text: "TEL. FIJO"; width: 120px; color: Theme.text-muted; font-size: 11px; font-weight: 800; vertical-alignment: center; }
                                    Text { text: "PARQUEADEROS PRIVADOS"; color: Theme.text-muted; font-size: 11px; font-weight: 800; vertical-alignment: center; }
                                }
                            }

                            for unit in root.units: Rectangle {
                                height: 42px;
                                background: Theme.bg-surface;
                                border-radius: 4px;
                                border-width: 1px;
                                border-color: #141417;

                                HorizontalLayout {
                                    padding-left: 14px;
                                    padding-right: 14px;

                                    Text { text: unit.unit-number; width: 110px; color: Theme.text-primary; font-size: 13px; font-weight: 800; vertical-alignment: center; }
                                    Text { text: unit.unit-type; width: 120px; color: Theme.text-secondary; font-size: 13px; vertical-alignment: center; }
                                    
                                    HorizontalLayout {
                                        width: 140px;
                                        spacing: 6px;
                                        Rectangle {
                                            width: 6px;
                                            height: 6px;
                                            border-radius: 3px;
                                            background: unit.intercom == "Sin citófono" ? #ef4444 : #22c55e;
                                            y: 18px;
                                        }
                                        Text {
                                            text: unit.intercom;
                                            color: unit.intercom == "Sin citófono" ? #f87171 : #4ade80;
                                            font-size: 12px;
                                            font-weight: 700;
                                            vertical-alignment: center;
                                        }
                                    }

                                    Text { text: unit.mobile; width: 140px; color: Theme.text-primary; font-size: 13px; font-weight: 600; vertical-alignment: center; }
                                    Text { text: unit.landline; width: 120px; color: Theme.text-muted; font-size: 13px; vertical-alignment: center; }
                                    
                                    Text {
                                        text: unit.parking;
                                        color: unit.parking == "Sin celda" ? #52525b : #38bdf8;
                                        font-size: 13px;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // ================================================================
            // 3C. VISTA RESIDENTES: DIRECTORIO DE PERSONAS EN LA UNIDAD
            // ================================================================
            if (root.active-module == "residentes"): Rectangle {
                vertical-stretch: 1;
                background: Theme.bg-panel;
                border-radius: 8px;
                border-width: 1px;
                border-color: Theme.border-subtle;

                VerticalLayout {
                    padding: 16px;
                    spacing: 12px;

                    // CABECERA + BOTÓN NUEVO RESIDENTE
                    HorizontalLayout {
                        vertical-stretch: 0;
                        alignment: space-between;

                        HorizontalLayout {
                            spacing: 10px;
                            VerticalLayout {
                                alignment: center;
                                Image { source: @image-url("icons/id-card.svg"); width: 20px; height: 20px; colorize: #2dd4bf; }
                            }
                            VerticalLayout {
                                spacing: 2px;
                                Text {
                                    text: "DIRECTORIO DE RESIDENTES";
                                    color: Theme.text-primary;
                                    font-size: 16px;
                                    font-weight: 900;
                                }
                                Text {
                                    text: "Propietarios, arrendatarios y grupo familiar registrados en la unidad";
                                    color: Theme.text-muted;
                                    font-size: 12px;
                                    font-weight: 500;
                                }
                            }
                        }

                        TacticalButton {
                            text: "NUEVO RESIDENTE";
                            icon: @image-url("icons/plus.svg");
                            has-icon: true;
                            primary: true;
                            clicked => { root.open-resident-drawer(); }
                        }
                    }

                    // BUSCADOR EN TIEMPO REAL
                    HorizontalLayout {
                        vertical-stretch: 0;
                        spacing: 8px;
                        VerticalLayout {
                            alignment: center;
                            Image { source: @image-url("icons/search.svg"); width: 16px; height: 16px; colorize: #2dd4bf; }
                        }
                        LineEdit {
                            height: 36px;
                            vertical-stretch: 0;
                            horizontal-stretch: 1;
                            text <=> root.resident-search-query;
                            placeholder-text: "Buscar residente por nombre, documento, inmueble o celular...";
                            edited(q) => { root.search-residents(q); }
                        }
                    }

                    Rectangle { height: 1px; background: Theme.border-subtle; }

                    // CABECERA DE TABLA
                    Rectangle {
                        height: 32px;
                        background: Theme.bg-surface;
                        border-radius: 4px;
                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            spacing: 10px;
                            Text { text: "RESIDENTE / DOCUMENTO"; horizontal-stretch: 3; color: Theme.text-muted; font-size: 11px; font-weight: 800; vertical-alignment: center; }
                            Text { text: "INMUEBLE"; horizontal-stretch: 2; color: Theme.text-muted; font-size: 11px; font-weight: 800; vertical-alignment: center; }
                            Text { text: "ROL"; width: 120px; color: Theme.text-muted; font-size: 11px; font-weight: 800; vertical-alignment: center; }
                            Text { text: "CELULAR"; width: 140px; color: Theme.text-muted; font-size: 11px; font-weight: 800; vertical-alignment: center; }
                            Text { text: "CORREO ELECTRÓNICO"; horizontal-stretch: 2; color: Theme.text-muted; font-size: 11px; font-weight: 800; vertical-alignment: center; }
                        }
                    }

                    if (root.residents.length == 0): Rectangle {
                        vertical-stretch: 1;
                        background: Theme.bg-surface;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: Theme.border-subtle;
                        VerticalLayout {
                            alignment: center;
                            spacing: 4px;
                            Text {
                                text: "No se encontraron residentes";
                                color: Theme.text-secondary;
                                font-size: 13px;
                                font-weight: 700;
                                horizontal-alignment: center;
                            }
                            Text {
                                text: "Intente otro término de búsqueda o registre un nuevo residente";
                                color: Theme.text-faint;
                                font-size: 11px;
                                horizontal-alignment: center;
                            }
                        }
                    }

                    if (root.residents.length > 0): ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            alignment: start;
                            spacing: 6px;
                            for res in root.residents: Rectangle {
                                height: 50px;
                                background: Theme.bg-surface;
                                border-radius: 6px;
                                border-width: 1px;
                                border-color: Theme.border-subtle;

                                HorizontalLayout {
                                    padding-left: 14px;
                                    padding-right: 14px;
                                    spacing: 10px;

                                    VerticalLayout {
                                        horizontal-stretch: 3;
                                        alignment: center;
                                        spacing: 2px;
                                        Text { text: res.full-name; color: Theme.text-primary; font-size: 13px; font-weight: 800; }
                                        Text { text: res.document; color: Theme.text-muted; font-size: 11px; font-weight: 600; }
                                    }

                                    Text {
                                        text: res.unit-label;
                                        horizontal-stretch: 2;
                                        color: #2dd4bf;
                                        font-size: 13px;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                    }

                                    VerticalLayout {
                                        width: 120px;
                                        alignment: center;
                                        Rectangle {
                                            width: 104px;
                                            height: 22px;
                                            border-radius: 4px;
                                            background: res.role == "Propietario" ? #134e4a : (res.role == "Arrendatario" ? #1e3a8a : #27272a);
                                            border-width: 1px;
                                            border-color: res.role == "Propietario" ? #2dd4bf : (res.role == "Arrendatario" ? #60a5fa : #52525b);

                                            Text {
                                                text: res.role;
                                                color: res.role == "Propietario" ? #5eead4 : (res.role == "Arrendatario" ? #93c5fd : #d4d4d8);
                                                font-size: 10px;
                                                font-weight: 800;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }

                                    Text {
                                        text: res.mobile;
                                        width: 140px;
                                        color: Theme.text-primary;
                                        font-size: 13px;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                    }

                                    Text {
                                        text: res.email;
                                        horizontal-stretch: 2;
                                        color: Theme.text-muted;
                                        font-size: 12px;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // ================================================================
            // 3D. VISTA CONFIGURACIÓN: APARIENCIA (OSCURO / CLARO) Y SISTEMA
            // ================================================================
            if (root.active-module == "config"): Rectangle {
                vertical-stretch: 1;
                background: Theme.bg-panel;
                border-radius: 8px;
                border-width: 1px;
                border-color: Theme.border-subtle;

                VerticalLayout {
                    padding: 22px;
                    spacing: 18px;

                    // CABECERA
                    HorizontalLayout {
                        vertical-stretch: 0;
                        spacing: 10px;
                        VerticalLayout {
                            alignment: center;
                            Image { source: @image-url("icons/settings.svg"); width: 20px; height: 20px; colorize: #94a3b8; }
                        }
                        VerticalLayout {
                            spacing: 2px;
                            Text {
                                text: "CONFIGURACIÓN DE LA APLICACIÓN";
                                color: Theme.text-primary;
                                font-size: 16px;
                                font-weight: 900;
                            }
                            Text {
                                text: "Personaliza la apariencia visual y preferencias de la terminal de portería";
                                color: Theme.text-muted;
                                font-size: 12px;
                                font-weight: 500;
                            }
                        }
                    }

                    Rectangle { height: 1px; background: Theme.border-subtle; }

                    // SECCIÓN: TEMA VISUAL
                    VerticalLayout {
                        vertical-stretch: 0;
                        spacing: 10px;

                        Text {
                            text: "TEMA VISUAL";
                            color: #38bdf8;
                            font-size: 11px;
                            font-weight: 800;
                        }

                        HorizontalLayout {
                            spacing: 14px;
                            height: 110px;

                            // TARJETA TEMA OSCURO
                            Rectangle {
                                horizontal-stretch: 1;
                                background: Theme.dark-mode ? #0c4a6e : Theme.bg-surface;
                                border-radius: 8px;
                                border-width: Theme.dark-mode ? 2px : 1px;
                                border-color: Theme.dark-mode ? #38bdf8 : Theme.border-strong;

                                dark-card-touch := TouchArea {
                                    clicked => {
                                        Theme.dark-mode = true;
                                        root.status-text = "Tema oscuro (True Black) activado.";
                                    }
                                }

                                HorizontalLayout {
                                    padding: 18px;
                                    spacing: 14px;
                                    alignment: start;

                                    VerticalLayout {
                                        alignment: center;
                                        Rectangle {
                                            width: 44px;
                                            height: 44px;
                                            border-radius: 22px;
                                            background: #09090b;
                                            border-width: 1px;
                                            border-color: #38bdf8;

                                            Image {
                                                source: @image-url("icons/moon.svg");
                                                width: 20px;
                                                height: 20px;
                                                colorize: #38bdf8;
                                            }
                                        }
                                    }

                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 4px;
                                        Text {
                                            text: "MODO OSCURO (TRUE BLACK)";
                                            color: Theme.dark-mode ? #ffffff : Theme.text-primary;
                                            font-size: 14px;
                                            font-weight: 900;
                                        }
                                        Text {
                                            text: "Negro puro de alto contraste. Ideal para turnos nocturnos 24/7.";
                                            color: Theme.dark-mode ? #bae6fd : Theme.text-muted;
                                            font-size: 11px;
                                            font-weight: 500;
                                        }
                                    }
                                }
                            }

                            // TARJETA TEMA CLARO
                            Rectangle {
                                horizontal-stretch: 1;
                                background: !Theme.dark-mode ? #e0f2fe : Theme.bg-surface;
                                border-radius: 8px;
                                border-width: !Theme.dark-mode ? 2px : 1px;
                                border-color: !Theme.dark-mode ? #0284c7 : Theme.border-strong;

                                light-card-touch := TouchArea {
                                    clicked => {
                                        Theme.dark-mode = false;
                                        root.status-text = "Tema claro activado.";
                                    }
                                }

                                HorizontalLayout {
                                    padding: 18px;
                                    spacing: 14px;
                                    alignment: start;

                                    VerticalLayout {
                                        alignment: center;
                                        Rectangle {
                                            width: 44px;
                                            height: 44px;
                                            border-radius: 22px;
                                            background: #ffffff;
                                            border-width: 1px;
                                            border-color: #f59e0b;

                                            Image {
                                                source: @image-url("icons/sun.svg");
                                                width: 20px;
                                                height: 20px;
                                                colorize: #f59e0b;
                                            }
                                        }
                                    }

                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 4px;
                                        Text {
                                            text: "MODO CLARO";
                                            color: !Theme.dark-mode ? #0f172a : Theme.text-primary;
                                            font-size: 14px;
                                            font-weight: 900;
                                        }
                                        Text {
                                            text: "Superficies claras de alta legibilidad para garitas con luz solar directa.";
                                            color: !Theme.dark-mode ? #334155 : Theme.text-muted;
                                            font-size: 11px;
                                            font-weight: 500;
                                        }
                                    }
                                }
                            }
                        }
                    }

                    Rectangle { height: 1px; background: Theme.border-subtle; }

                    // SECCIÓN: INFORMACIÓN DE LA TERMINAL
                    VerticalLayout {
                        vertical-stretch: 0;
                        spacing: 8px;
                        Text {
                            text: "INFORMACIÓN DE LA TERMINAL";
                            color: Theme.text-muted;
                            font-size: 11px;
                            font-weight: 800;
                        }
                        Rectangle {
                            height: 68px;
                            background: Theme.bg-surface;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: Theme.border-subtle;

                            HorizontalLayout {
                                padding-left: 16px;
                                padding-right: 16px;
                                alignment: space-between;

                                VerticalLayout {
                                    alignment: center;
                                    spacing: 2px;
                                    Text { text: "Mamori Terminal Windows Nativa v0.1.0"; color: Theme.text-primary; font-size: 13px; font-weight: 800; }
                                    Text { text: "Motor gráfico: Slint + Rust nativo | Tema activo: " + (Theme.dark-mode ? "Oscuro (True Black)" : "Claro"); color: Theme.text-muted; font-size: 11px; }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    Text { text: root.current-user-name + " (" + root.current-user-role + ")"; color: #38bdf8; font-size: 12px; font-weight: 700; }
                                }
                            }
                        }
                    }

                    Rectangle { vertical-stretch: 1; }
                }
            }

            // ================================================================
            // 3E. VISTAS EN CONSTRUCCIÓN (VISITAS, VEHÍCULOS, PAQUETERÍA, MINUTA)
            // ================================================================
            if (root.active-module != "home" && root.active-module != "unidades" && root.active-module != "residentes" && root.active-module != "config"): Rectangle {
                vertical-stretch: 1;
                background: Theme.bg-panel;
                border-radius: 8px;
                border-width: 1px;
                border-color: Theme.border-subtle;

                VerticalLayout {
                    alignment: center;
                    spacing: 12px;

                    Text {
                        text: "MÓDULO EN CONSTRUCCIÓN: " + root.current-view-title;
                        color: Theme.text-primary;
                        font-size: 18px;
                        font-weight: 900;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: "Este módulo será especificado e implementado en la siguiente iteración.";
                        color: Theme.text-muted;
                        font-size: 13px;
                        horizontal-alignment: center;
                    }
                    HorizontalLayout {
                        alignment: center;
                        TacticalButton {
                            text: "VOLVER A HOME [F1]";
                            active: true;
                            clicked => { root.quick-action("home"); }
                        }
                    }
                }
            }

            // 4. FOOTER TÁCTICO INFERIOR
            HorizontalLayout {
                alignment: space-between;
                Text {
                    text: "ATAJOS: [F1] HOME | [F2] VISITAS | [F3] VEHÍCULOS | [F4] PAQUETERÍA | [F5] RESIDENTES | [F6] MINUTA | [F7] UNIDADES | [F8] CONFIG";
                    color: Theme.text-faint;
                    font-size: 11px;
                    font-weight: 700;
                }
                Text {
                    text: "MAMORI v0.1.0 — TERMINAL NATIVA DE PORTERÍA (SLINT / RUST)";
                    color: Theme.text-faint;
                    font-size: 11px;
                    font-weight: 700;
                }
            }
            }
        }
    }

    // ========================================================================
    // CAPA LATERAL: PANEL DERECHO (DRAWER DE NUEVO INMUEBLE)
    // ========================================================================
    if (root.show-drawer): Rectangle {
        width: 100%;
        height: 100%;
        background: #000000a6;

        TouchArea {
            clicked => { root.cancel-drawer(); }
        }

        Rectangle {
            x: parent.width - self.width;
            y: 0;
            width: 500px;
            height: parent.height;
            background: Theme.bg-panel;
            border-width: 1px;
            border-color: #27272a;

            TouchArea {
                clicked => { /* Absorbe clics internos */ }
            }

            drawer-scope := FocusScope {
                key-pressed(event) => {
                    if (event.text == Key.Escape) {
                        if (root.show-parking-picker) {
                            root.close-parking-picker();
                            return accept;
                        }
                        root.cancel-drawer();
                        return accept;
                    }
                    return reject;
                }

                VerticalLayout {
                    padding: 22px;
                    spacing: 14px;

                    // CABECERA DEL PANEL
                    HorizontalLayout {
                        alignment: space-between;

                        VerticalLayout {
                            spacing: 2px;
                            Text {
                                text: "NUEVO INMUEBLE";
                                color: Theme.text-primary;
                                font-size: 18px;
                                font-weight: 900;
                            }
                            Text {
                                text: "Torre destino: " + root.selected-tower;
                                color: #38bdf8;
                                font-size: 13px;
                                font-weight: 600;
                            }
                        }

                        Rectangle {
                            width: 32px;
                            height: 32px;
                            border-radius: 16px;
                            background: close-touch.has-hover ? #27272a : #18181b;

                            close-touch := TouchArea {
                                clicked => { root.cancel-drawer(); }
                            }

                            Image {
                                source: @image-url("icons/x.svg");
                                width: 16px;
                                height: 16px;
                                colorize: close-touch.has-hover ? #ffffff : #a1a1aa;
                            }
                        }
                    }

                    Rectangle { height: 1px; background: Theme.border-subtle; }

                    // CAMPOS BASE
                    VerticalLayout {
                        vertical-stretch: 0;
                        spacing: 12px;

                        VerticalLayout {
                            vertical-stretch: 0;
                            spacing: 4px;
                            Text { text: "NÚMERO DE INMUEBLE / PREDIO:"; color: Theme.text-secondary; font-size: 11px; font-weight: 800; }
                            LineEdit {
                                height: 36px;
                                vertical-stretch: 0;
                                horizontal-stretch: 1;
                                text <=> root.form-unit-number;
                                placeholder-text: "Ej: 301, 102A, Casa 15";
                            }
                        }

                        VerticalLayout {
                            vertical-stretch: 0;
                            spacing: 4px;
                            Text { text: "CITÓFONO / EXTENSIÓN FÍSICA:"; color: Theme.text-secondary; font-size: 11px; font-weight: 800; }
                            LineEdit {
                                height: 36px;
                                vertical-stretch: 0;
                                horizontal-stretch: 1;
                                text <=> root.form-intercom;
                                placeholder-text: "Ej: Ext. 301 o 'Sin citófono'";
                            }
                        }

                        VerticalLayout {
                            vertical-stretch: 0;
                            spacing: 4px;
                            Text { text: "CELULAR:"; color: Theme.text-secondary; font-size: 11px; font-weight: 800; }
                            LineEdit {
                                height: 36px;
                                vertical-stretch: 0;
                                horizontal-stretch: 1;
                                text <=> root.form-mobile;
                                placeholder-text: "Ej: 300 123 4567";
                            }
                        }

                        VerticalLayout {
                            vertical-stretch: 0;
                            spacing: 4px;
                            Text { text: "TELÉFONO FIJO (OPCIONAL):"; color: Theme.text-secondary; font-size: 11px; font-weight: 800; }
                            LineEdit {
                                height: 36px;
                                vertical-stretch: 0;
                                horizontal-stretch: 1;
                                text <=> root.form-landline;
                                placeholder-text: "Ej: (604) 444 0000";
                            }
                        }
                    }

                    Rectangle { height: 1px; background: Theme.border-subtle; }

                    // ========================================================
                    // SECCIÓN DE PARQUEADEROS PRIVADOS ASIGNADOS
                    // ========================================================
                    VerticalLayout {
                        vertical-stretch: 0;
                        spacing: 8px;

                        HorizontalLayout {
                            alignment: space-between;
                            Text {
                                text: "PARQUEADEROS PRIVADOS ASIGNADOS:";
                                color: #38bdf8;
                                font-size: 11px;
                                font-weight: 800;
                                vertical-alignment: center;
                            }

                            // Botón para crear nueva bahía en la copropiedad
                            TouchArea {
                                width: 140px;
                                height: 24px;
                                clicked => { root.show-parking-modal = true; }

                                Text {
                                    text: "NUEVO PARQUEADERO";
                                    color: #22c55e;
                                    font-size: 10px;
                                    font-weight: 800;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        // Lista de celdas asignadas al inmueble
                        if (root.selected-parking-list.length == 0): Rectangle {
                            height: 38px;
                            background: Theme.bg-surface;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: Theme.border-subtle;

                            HorizontalLayout {
                                padding-left: 14px;
                                Text {
                                    text: "Ningún parqueadero asignado a este predio";
                                    color: Theme.text-faint;
                                    font-size: 12px;
                                    font-weight: 500;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        for spot-val[idx] in root.selected-parking-list: Rectangle {
                            height: 38px;
                            background: Theme.bg-surface;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: #27272a;

                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 8px;
                                alignment: space-between;

                                HorizontalLayout {
                                    spacing: 8px;
                                    Rectangle {
                                        width: 6px;
                                        height: 6px;
                                        border-radius: 3px;
                                        background: #38bdf8;
                                        y: 16px;
                                    }
                                    Text {
                                        text: spot-val;
                                        color: Theme.text-primary;
                                        font-size: 13px;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    DeleteButton {
                                        clicked => {
                                            root.remove-parking-selection(idx);
                                        }
                                    }
                                }
                            }
                        }

                        // Botón para abrir el panel de asignación
                        TacticalButton {
                            text: "ASIGNAR PARQUEADERO";
                            icon: @image-url("icons/plus.svg");
                            has-icon: true;
                            h-stretch: 1;
                            font-size: 12px;
                            active: root.show-parking-picker;
                            clicked => {
                                root.open-parking-picker();
                            }
                        }
                    }

                    Rectangle { vertical-stretch: 1; }
                    Rectangle { height: 1px; background: Theme.border-subtle; }

                    // BOTONES DE ACCIÓN INFERIORES
                    VerticalLayout {
                        vertical-stretch: 0;
                        spacing: 8px;

                        TacticalButton {
                            text: "GUARDAR INMUEBLE";
                            icon: @image-url("icons/check.svg");
                            has-icon: true;
                            primary: true;
                            h-stretch: 1;
                            font-size: 13px;
                            clicked => {
                                root.save-unit();
                            }
                        }

                        TacticalButton {
                            text: "CANCELAR [ESC]";
                            icon: @image-url("icons/x.svg");
                            has-icon: true;
                            h-stretch: 1;
                            font-size: 12px;
                            clicked => {
                                root.cancel-drawer();
                            }
                        }
                    }
                }

                // ============================================================
                // SUB-PANEL INFERIOR: BÚSQUEDA Y ASIGNACIÓN DE PARQUEADEROS
                // ============================================================
                if (root.show-parking-picker): Rectangle {
                    x: 0;
                    y: parent.height - self.height;
                    width: parent.width;
                    height: 440px;
                    background: Theme.bg-panel;
                    border-width: 1px;
                    border-color: #38bdf8;
                    border-radius: 8px;

                    TouchArea { clicked => { /* Absorbe clics internos */ } }

                    VerticalLayout {
                        padding: 16px;
                        spacing: 10px;

                        // CABECERA
                        HorizontalLayout {
                            alignment: space-between;

                            VerticalLayout {
                                spacing: 2px;
                                Text {
                                    text: "PARQUEADEROS DISPONIBLES";
                                    color: Theme.text-primary;
                                    font-size: 14px;
                                    font-weight: 900;
                                }
                                Text {
                                    text: "Seleccione una celda para asignarla a este inmueble";
                                    color: Theme.text-secondary;
                                    font-size: 11px;
                                    font-weight: 500;
                                }
                            }

                            Rectangle {
                                width: 28px;
                                height: 28px;
                                border-radius: 14px;
                                background: picker-close-touch.has-hover ? #27272a : #18181b;

                                picker-close-touch := TouchArea {
                                    clicked => { root.close-parking-picker(); }
                                }

                                Image {
                                    source: @image-url("icons/x.svg");
                                    width: 14px;
                                    height: 14px;
                                    colorize: picker-close-touch.has-hover ? #ffffff : #a1a1aa;
                                }
                            }
                        }

                        Rectangle { height: 1px; background: #27272a; }

                        // BUSCADOR EN TIEMPO REAL
                        VerticalLayout {
                            vertical-stretch: 0;
                            spacing: 4px;
                            HorizontalLayout {
                                spacing: 5px;
                                alignment: start;
                                VerticalLayout {
                                    alignment: center;
                                    Image { source: @image-url("icons/search.svg"); width: 12px; height: 12px; colorize: #38bdf8; }
                                }
                                Text {
                                    text: "BUSCADOR DE CELDAS:";
                                    color: #38bdf8;
                                    font-size: 10px;
                                    font-weight: 800;
                                    vertical-alignment: center;
                                }
                            }
                            LineEdit {
                                height: 36px;
                                vertical-stretch: 0;
                                horizontal-stretch: 1;
                                text <=> root.parking-search-query;
                                placeholder-text: "Buscar por código (ej: P-105) o tipo (Carro / Moto)...";
                                edited(q) => {
                                    root.search-parking(q);
                                }
                            }
                        }

                        // LISTA DE RESULTADOS
                        if (root.filtered-parking-options.length == 0): Rectangle {
                            vertical-stretch: 1;
                            background: Theme.bg-surface;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: Theme.border-subtle;

                            VerticalLayout {
                                alignment: center;
                                spacing: 4px;
                                Text {
                                    text: "No se encontraron parqueaderos disponibles";
                                    color: Theme.text-secondary;
                                    font-size: 12px;
                                    font-weight: 700;
                                    horizontal-alignment: center;
                                }
                                Text {
                                    text: "Verifique el término de búsqueda o cree una nueva bahía";
                                    color: Theme.text-faint;
                                    font-size: 11px;
                                    horizontal-alignment: center;
                                }
                            }
                        }

                        if (root.filtered-parking-options.length > 0): ScrollView {
                            vertical-stretch: 1;
                            VerticalLayout {
                                alignment: start;
                                spacing: 6px;
                                for item in root.filtered-parking-options: Rectangle {
                                    height: 40px;
                                    background: spot-item-touch.has-hover ? #18181b : #050507;
                                    border-radius: 6px;
                                    border-width: 1px;
                                    border-color: spot-item-touch.has-hover ? #38bdf8 : #27272a;

                                    spot-item-touch := TouchArea {
                                        clicked => {
                                            root.pick-parking(item.display-name);
                                        }
                                    }

                                    HorizontalLayout {
                                        padding-left: 14px;
                                        padding-right: 14px;
                                        alignment: space-between;

                                        HorizontalLayout {
                                            spacing: 10px;
                                            VerticalLayout {
                                                alignment: center;
                                                Image {
                                                    source: item.spot-type == "Moto" ? @image-url("icons/bike.svg") : @image-url("icons/car.svg");
                                                    width: 15px;
                                                    height: 15px;
                                                    colorize: item.spot-type == "Moto" ? #d8b4fe : #7dd3fc;
                                                }
                                            }
                                            Text {
                                                text: item.code;
                                                color: Theme.text-primary;
                                                font-size: 13px;
                                                font-weight: 800;
                                                vertical-alignment: center;
                                            }
                                            Rectangle {
                                                width: 60px;
                                                height: 20px;
                                                border-radius: 4px;
                                                background: item.spot-type == "Moto" ? #3b0764 : #0c4a6e;
                                                border-width: 1px;
                                                border-color: item.spot-type == "Moto" ? #a855f7 : #38bdf8;
                                                y: 10px;

                                                Text {
                                                    text: item.spot-type;
                                                    color: item.spot-type == "Moto" ? #d8b4fe : #7dd3fc;
                                                    font-size: 10px;
                                                    font-weight: 800;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }

                                        Text {
                                            text: "ASIGNAR ↵";
                                            color: spot-item-touch.has-hover ? #22c55e : #71717a;
                                            font-size: 11px;
                                            font-weight: 800;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }

                        TacticalButton {
                            text: "CERRAR LISTA [ESC]";
                            icon: @image-url("icons/x.svg");
                            has-icon: true;
                            h-stretch: 1;
                            font-size: 11px;
                            clicked => {
                                root.close-parking-picker();
                            }
                        }
                    }
                }
            }
        }
    }

    // ========================================================================
    // CAPA LATERAL: PANEL DERECHO (DRAWER DE NUEVO PARQUEADERO)
    // ========================================================================
    if (root.show-parking-modal): Rectangle {
        width: 100%;
        height: 100%;
        background: #000000a6;

        TouchArea {
            clicked => { root.show-parking-modal = false; }
        }

        Rectangle {
            x: parent.width - self.width;
            y: 0;
            width: 500px;
            height: parent.height;
            background: Theme.bg-panel;
            border-width: 1px;
            border-color: #27272a;

            TouchArea {
                clicked => { /* Absorbe clics internos */ }
            }

            parking-drawer-scope := FocusScope {
                key-pressed(event) => {
                    if (event.text == Key.Escape) {
                        root.show-parking-modal = false;
                        return accept;
                    }
                    return reject;
                }

                VerticalLayout {
                    padding: 22px;
                    spacing: 14px;

                    // CABECERA DEL PANEL
                    HorizontalLayout {
                        alignment: space-between;

                        VerticalLayout {
                            spacing: 2px;
                            Text {
                                text: "NUEVO PARQUEADERO";
                                color: Theme.text-primary;
                                font-size: 18px;
                                font-weight: 900;
                            }
                            Text {
                                text: "Catálogo de bahías de la copropiedad";
                                color: #38bdf8;
                                font-size: 13px;
                                font-weight: 600;
                            }
                        }

                        Rectangle {
                            width: 32px;
                            height: 32px;
                            border-radius: 16px;
                            background: close-pk-touch.has-hover ? #27272a : #18181b;

                            close-pk-touch := TouchArea {
                                clicked => { root.show-parking-modal = false; }
                            }

                            Image {
                                source: @image-url("icons/x.svg");
                                width: 16px;
                                height: 16px;
                                colorize: close-pk-touch.has-hover ? #ffffff : #a1a1aa;
                            }
                        }
                    }

                    Rectangle { height: 1px; background: Theme.border-subtle; }

                    // CAMPOS DEL PARQUEADERO
                    VerticalLayout {
                        vertical-stretch: 0;
                        spacing: 12px;

                        VerticalLayout {
                            vertical-stretch: 0;
                            spacing: 5px;
                            Text { text: "CÓDIGO / IDENTIFICADOR DE BAHÍA:"; color: Theme.text-secondary; font-size: 11px; font-weight: 800; }
                            LineEdit {
                                height: 36px;
                                vertical-stretch: 0;
                                horizontal-stretch: 1;
                                text <=> root.form-parking-code;
                                placeholder-text: "Ej: P-107, Celda M-05";
                            }
                        }

                        VerticalLayout {
                            vertical-stretch: 0;
                            spacing: 5px;
                            Text { text: "TIPO DE VEHÍCULO:"; color: Theme.text-secondary; font-size: 11px; font-weight: 800; }
                            HorizontalLayout {
                                spacing: 8px;
                                TacticalButton {
                                    text: "CARRO";
                                    icon: @image-url("icons/car.svg");
                                    has-icon: true;
                                    h-stretch: 1;
                                    active: root.form-parking-type == "Carro";
                                    clicked => { root.form-parking-type = "Carro"; }
                                }
                                TacticalButton {
                                    text: "MOTO";
                                    icon: @image-url("icons/bike.svg");
                                    has-icon: true;
                                    h-stretch: 1;
                                    active: root.form-parking-type == "Moto";
                                    clicked => { root.form-parking-type = "Moto"; }
                                }
                            }
                        }
                    }

                    Rectangle { vertical-stretch: 1; }
                    Rectangle { height: 1px; background: Theme.border-subtle; }

                    // BOTONES DE ACCIÓN INFERIORES
                    VerticalLayout {
                        vertical-stretch: 0;
                        spacing: 8px;

                        TacticalButton {
                            text: "GUARDAR PARQUEADERO";
                            icon: @image-url("icons/check.svg");
                            has-icon: true;
                            primary: true;
                            h-stretch: 1;
                            font-size: 13px;
                            clicked => {
                                root.create-new-parking();
                            }
                        }

                        TacticalButton {
                            text: "CANCELAR [ESC]";
                            icon: @image-url("icons/x.svg");
                            has-icon: true;
                            h-stretch: 1;
                            font-size: 12px;
                            clicked => {
                                root.show-parking-modal = false;
                            }
                        }
                    }
                }
            }
        }
    }

    // ========================================================================
    // CAPA LATERAL: PANEL DERECHO (DRAWER DE NUEVO RESIDENTE)
    // ========================================================================
    if (root.show-resident-drawer): Rectangle {
        width: 100%;
        height: 100%;
        background: #000000a6;

        TouchArea {
            clicked => { root.cancel-resident-drawer(); }
        }

        Rectangle {
            x: parent.width - self.width;
            y: 0;
            width: 500px;
            height: parent.height;
            background: Theme.bg-panel;
            border-width: 1px;
            border-color: #27272a;

            TouchArea {
                clicked => { /* Absorbe clics internos */ }
            }

            resident-drawer-scope := FocusScope {
                key-pressed(event) => {
                    if (event.text == Key.Escape) {
                        root.cancel-resident-drawer();
                        return accept;
                    }
                    return reject;
                }

                VerticalLayout {
                    padding: 22px;
                    spacing: 14px;

                    // CABECERA DEL PANEL
                    HorizontalLayout {
                        alignment: space-between;

                        VerticalLayout {
                            spacing: 2px;
                            Text {
                                text: "NUEVO RESIDENTE";
                                color: Theme.text-primary;
                                font-size: 18px;
                                font-weight: 900;
                            }
                            Text {
                                text: "Registro de persona habitante en la unidad residencial";
                                color: #2dd4bf;
                                font-size: 13px;
                                font-weight: 600;
                            }
                        }

                        Rectangle {
                            width: 32px;
                            height: 32px;
                            border-radius: 16px;
                            background: close-res-touch.has-hover ? #27272a : #18181b;

                            close-res-touch := TouchArea {
                                clicked => { root.cancel-resident-drawer(); }
                            }

                            Image {
                                source: @image-url("icons/x.svg");
                                width: 16px;
                                height: 16px;
                                colorize: close-res-touch.has-hover ? #ffffff : #a1a1aa;
                            }
                        }
                    }

                    Rectangle { height: 1px; background: Theme.border-subtle; }

                    // CAMPOS DEL RESIDENTE
                    VerticalLayout {
                        vertical-stretch: 0;
                        spacing: 12px;

                        VerticalLayout {
                            vertical-stretch: 0;
                            spacing: 4px;
                            Text { text: "DOCUMENTO DE IDENTIDAD:"; color: Theme.text-secondary; font-size: 11px; font-weight: 800; }
                            LineEdit {
                                height: 36px;
                                vertical-stretch: 0;
                                horizontal-stretch: 1;
                                text <=> root.form-resident-doc;
                                placeholder-text: "Ej: CC 1.017.234.567";
                            }
                        }

                        VerticalLayout {
                            vertical-stretch: 0;
                            spacing: 4px;
                            Text { text: "NOMBRE COMPLETO:"; color: Theme.text-secondary; font-size: 11px; font-weight: 800; }
                            LineEdit {
                                height: 36px;
                                vertical-stretch: 0;
                                horizontal-stretch: 1;
                                text <=> root.form-resident-name;
                                placeholder-text: "Ej: María Fernanda López";
                            }
                        }

                        VerticalLayout {
                            vertical-stretch: 0;
                            spacing: 4px;
                            Text { text: "INMUEBLE / PREDIO ASOCIADO:"; color: Theme.text-secondary; font-size: 11px; font-weight: 800; }
                            LineEdit {
                                height: 36px;
                                vertical-stretch: 0;
                                horizontal-stretch: 1;
                                text <=> root.form-resident-unit;
                                placeholder-text: "Ej: Torre 1 - Apto 301";
                            }
                        }

                        VerticalLayout {
                            vertical-stretch: 0;
                            spacing: 5px;
                            Text { text: "ROL EN LA UNIDAD:"; color: Theme.text-secondary; font-size: 11px; font-weight: 800; }
                            HorizontalLayout {
                                spacing: 8px;
                                TacticalButton {
                                    text: "PROPIETARIO";
                                    h-stretch: 1;
                                    font-size: 11px;
                                    active: root.form-resident-role == "Propietario";
                                    clicked => { root.form-resident-role = "Propietario"; }
                                }
                                TacticalButton {
                                    text: "ARRENDATARIO";
                                    h-stretch: 1;
                                    font-size: 11px;
                                    active: root.form-resident-role == "Arrendatario";
                                    clicked => { root.form-resident-role = "Arrendatario"; }
                                }
                                TacticalButton {
                                    text: "FAMILIAR";
                                    h-stretch: 1;
                                    font-size: 11px;
                                    active: root.form-resident-role == "Familiar";
                                    clicked => { root.form-resident-role = "Familiar"; }
                                }
                            }
                        }

                        VerticalLayout {
                            vertical-stretch: 0;
                            spacing: 4px;
                            Text { text: "CELULAR:"; color: Theme.text-secondary; font-size: 11px; font-weight: 800; }
                            LineEdit {
                                height: 36px;
                                vertical-stretch: 0;
                                horizontal-stretch: 1;
                                text <=> root.form-resident-mobile;
                                placeholder-text: "Ej: 300 456 7890";
                            }
                        }

                        VerticalLayout {
                            vertical-stretch: 0;
                            spacing: 4px;
                            Text { text: "CORREO ELECTRÓNICO (OPCIONAL):"; color: Theme.text-secondary; font-size: 11px; font-weight: 800; }
                            LineEdit {
                                height: 36px;
                                vertical-stretch: 0;
                                horizontal-stretch: 1;
                                text <=> root.form-resident-email;
                                placeholder-text: "Ej: maria.lopez@correo.com";
                            }
                        }
                    }

                    Rectangle { vertical-stretch: 1; }
                    Rectangle { height: 1px; background: Theme.border-subtle; }

                    // BOTONES DE ACCIÓN INFERIORES
                    VerticalLayout {
                        vertical-stretch: 0;
                        spacing: 8px;

                        TacticalButton {
                            text: "GUARDAR RESIDENTE";
                            icon: @image-url("icons/check.svg");
                            has-icon: true;
                            primary: true;
                            h-stretch: 1;
                            font-size: 13px;
                            clicked => { root.save-resident(); }
                        }

                        TacticalButton {
                            text: "CANCELAR [ESC]";
                            icon: @image-url("icons/x.svg");
                            has-icon: true;
                            h-stretch: 1;
                            font-size: 12px;
                            clicked => { root.cancel-resident-drawer(); }
                        }
                    }
                }
            }
        }
    }

    // ========================================================================
    // PANTALLA DE INICIO DE SESIÓN (LOGIN NATIVO)
    // ========================================================================
    if (!root.is-authenticated): Rectangle {
        width: 100%;
        height: 100%;
        background: Theme.bg-window;

        TouchArea { clicked => {} }

        Rectangle {
            width: 410px;
            height: 440px;
            background: Theme.bg-panel;
            border-radius: 12px;
            border-width: 1px;
            border-color: Theme.border-strong;

            VerticalLayout {
                padding: 28px;
                spacing: 16px;

                // MARCA MAMORI
                VerticalLayout {
                    vertical-stretch: 0;
                    spacing: 8px;
                    alignment: center;

                    HorizontalLayout {
                        alignment: center;
                        Rectangle {
                            width: 54px;
                            height: 54px;
                            border-radius: 27px;
                            background: #0c4a6e;
                            border-width: 1px;
                            border-color: #38bdf8;

                            Image {
                                source: @image-url("icons/shield.svg");
                                width: 26px;
                                height: 26px;
                                colorize: #38bdf8;
                            }
                        }
                    }

                    Text {
                        text: "MAMORI";
                        color: Theme.text-primary;
                        font-size: 24px;
                        font-weight: 900;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: "CONTROL DE ACCESO Y SEGURIDAD RESIDENCIAL";
                        color: Theme.text-muted;
                        font-size: 11px;
                        font-weight: 700;
                        horizontal-alignment: center;
                    }
                }

                Rectangle { height: 1px; background: Theme.border-subtle; }

                // CREDENCIALES
                VerticalLayout {
                    vertical-stretch: 0;
                    spacing: 12px;

                    VerticalLayout {
                        vertical-stretch: 0;
                        spacing: 4px;
                        Text { text: "USUARIO:"; color: Theme.text-secondary; font-size: 11px; font-weight: 800; }
                        LineEdit {
                            height: 36px;
                            vertical-stretch: 0;
                            horizontal-stretch: 1;
                            text <=> root.login-username;
                            placeholder-text: "Ej: porteria o admin";
                            accepted => { root.attempt-login(); }
                        }
                    }

                    VerticalLayout {
                        vertical-stretch: 0;
                        spacing: 4px;
                        Text { text: "CONTRASEÑA:"; color: Theme.text-secondary; font-size: 11px; font-weight: 800; }
                        LineEdit {
                            height: 36px;
                            vertical-stretch: 0;
                            horizontal-stretch: 1;
                            input-type: password;
                            text <=> root.login-password;
                            placeholder-text: "Ingrese su contraseña";
                            accepted => { root.attempt-login(); }
                        }
                    }
                }

                // MENSAJE DE ERROR
                if (root.login-error != ""): Rectangle {
                    vertical-stretch: 0;
                    height: 34px;
                    background: #450a0a;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: #ef4444;

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        alignment: center;
                        Text {
                            text: root.login-error;
                            color: #fca5a5;
                            font-size: 11px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                    }
                }

                Rectangle { vertical-stretch: 1; }

                TacticalButton {
                    text: "INICIAR SESIÓN";
                    icon: @image-url("icons/check.svg");
                    has-icon: true;
                    primary: true;
                    h-stretch: 1;
                    font-size: 13px;
                    clicked => { root.attempt-login(); }
                }

                Text {
                    text: "Terminal Nativa Windows • v0.1.0";
                    color: Theme.text-faint;
                    font-size: 10px;
                    font-weight: 700;
                    horizontal-alignment: center;
                }
            }
        }
    }
}
