import { LineEdit, ScrollView, ComboBox } from "std-widgets.slint";

// ============================================================================
// COMPONENTES TÁCTICOS CON ESTILO NEGRO PURO Y AUTO-AJUSTE DINÁMICO
// ============================================================================

component TacticalButton inherits Rectangle {
    in property <string> text;
    in property <bool> active: false;
    in property <bool> primary: false;
    in property <length> font-size: 13px;
    in property <int> h-stretch: 0;
    callback clicked;

    horizontal-stretch: root.h-stretch;
    height: 38px;
    min-width: txt.min-width + 24px;
    border-radius: 6px;
    border-width: 1px;
    border-color: root.active ? #38bdf8 : (root.primary ? #22c55e : (touch.has-hover ? #3f3f46 : #27272a));
    background: root.active ? #0c4a6e : (root.primary ? #14532d : (touch.has-hover ? #18181b : #09090b));

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        alignment: center;

        txt := Text {
            text: root.text;
            color: root.active ? #ffffff : (root.primary ? #4ade80 : (touch.has-hover ? #fafafa : #a1a1aa));
            font-size: root.font-size;
            font-weight: 700;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }
}

// Botón de eliminar rojo táctico para filas de parqueaderos
component DeleteButton inherits Rectangle {
    callback clicked;

    width: 72px;
    height: 24px;
    border-radius: 4px;
    border-width: 1px;
    border-color: del-touch.has-hover ? #ef4444 : #3f1515;
    background: del-touch.has-hover ? #450a0a : #180909;

    del-touch := TouchArea {
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        alignment: center;
        Text {
            text: "ELIMINAR";
            color: del-touch.has-hover ? #ffffff : #f87171;
            font-size: 10px;
            font-weight: 800;
            vertical-alignment: center;
        }
    }
}

// Botón de acción compacto para filas del dashboard (Dar salida / Entregar)
component CompactActionButton inherits Rectangle {
    in property <string> text;
    in property <bool> positive: false;
    callback clicked;

    height: 26px;
    min-width: txt.min-width + 18px;
    border-radius: 4px;
    border-width: 1px;
    border-color: root.positive
        ? (btn-touch.has-hover ? #22c55e : #14532d)
        : (btn-touch.has-hover ? #38bdf8 : #1e3a5f);
    background: root.positive
        ? (btn-touch.has-hover ? #14532d : #052e16)
        : (btn-touch.has-hover ? #0c4a6e : #082f49);

    btn-touch := TouchArea {
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        alignment: center;
        txt := Text {
            text: root.text;
            color: btn-touch.has-hover ? #ffffff : (root.positive ? #4ade80 : #7dd3fc);
            font-size: 10px;
            font-weight: 800;
            vertical-alignment: center;
        }
    }
}

// Ítem de navegación para el panel lateral izquierdo colapsable
component SidebarNavItem inherits Rectangle {
    in property <string> shortcut;
    in property <string> label;
    in property <bool> active: false;
    in property <bool> collapsed: false;
    callback clicked;

    height: 40px;
    border-radius: 6px;
    border-width: 1px;
    border-color: root.active ? #38bdf8 : (nav-touch.has-hover ? #3f3f46 : transparent);
    background: root.active ? #0c4a6e : (nav-touch.has-hover ? #18181b : transparent);

    nav-touch := TouchArea {
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: root.collapsed ? 0px : 10px;
        padding-right: root.collapsed ? 0px : 10px;
        spacing: 10px;
        alignment: root.collapsed ? center : start;

        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 30px;
                height: 22px;
                border-radius: 4px;
                background: root.active ? #0369a1 : #18181b;
                border-width: 1px;
                border-color: root.active ? #38bdf8 : #27272a;

                Text {
                    text: root.shortcut;
                    color: root.active ? #ffffff : #a1a1aa;
                    font-size: 10px;
                    font-weight: 800;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        if (!root.collapsed): Text {
            text: root.label;
            color: root.active ? #ffffff : (nav-touch.has-hover ? #e4e4e7 : #a1a1aa);
            font-size: 12px;
            font-weight: 800;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

// Estructuras de datos para Slint
export struct ActiveVisitItem {
    id: string,
    visitor_name: string,
    document: string,
    destination: string,
    entry_time: string,
    access_type: string,
}

export struct PendingPackageItem {
    id: string,
    destination: string,
    recipient: string,
    carrier: string,
    description: string,
    received_time: string,
}

export struct ParkingPickerItem {
    code: string,
    spot_type: string,
    display_name: string,
}

export struct UnitItem {
    id: string,
    tower: string,
    unit_number: string,
    unit_type: string,
    intercom: string,
    mobile: string,
    landline: string,
    parking: string,
}

export struct TowerItem {
    id: string,
    name: string,
    unit_count: int,
}

// ============================================================================
// VENTANA PRINCIPAL — MAMORI BLACK EDITION
// ============================================================================
export component AppWindow inherits Window {
    title: "MAMORI — Terminal de Portería (Black Edition)";
    preferred-width: 1200px;
    preferred-height: 780px;
    min-width: 1000px;
    min-height: 700px;
    background: #000000; // NEGRO PURO

    in-out property <string> active-module: "home";
    in-out property <bool> sidebar-collapsed: false;
    in-out property <string> status-text: "SISTEMA OPERATIVO | BASE DE DATOS LOCAL SINCRONIZADA";
    in-out property <[ActiveVisitItem]> active-visits: [];
    in-out property <[PendingPackageItem]> pending-packages: [];
    in-out property <string> selected-tower: "Torre 1";
    in-out property <bool> show-drawer: false;
    in-out property <bool> show-parking-modal: false;
    in-out property <bool> show-parking-picker: false;
    in-out property <string> parking-search-query: "";
    in-out property <[ParkingPickerItem]> filtered-parking-options: [];

    // Campos del formulario inmueble
    in-out property <string> form-unit-number: "";
    in-out property <string> form-unit-type: "Apartamento";
    in-out property <string> form-intercom: "";
    in-out property <string> form-mobile: "";
    in-out property <string> form-landline: "";

    // Campos para crear nuevo parqueadero
    in-out property <string> form-parking-code: "";
    in-out property <string> form-parking-type: "Carro";

    // Opciones disponibles para los ComboBox
    in-out property <[string]> available-parking-options: [
        "-- Seleccionar parqueadero --",
        "P-104 (Carro)",
        "P-105 (Carro)",
        "P-106 (Carro)",
        "P-107 (Carro)",
        "M-01 (Moto)",
        "M-02 (Moto)",
        "M-03 (Moto)",
        "M-04 (Moto)"
    ];

    // Lista dinámica de parqueaderos asignados al inmueble actual
    in-out property <[string]> selected-parking-list: [];
    in-out property <string> new-parking-selector-value: "-- Seleccionar parqueadero --";

    // Listas reactivas
    in-out property <[TowerItem]> towers: [
        { id: "t1", name: "Torre 1", unit_count: 24 },
        { id: "t2", name: "Torre 2", unit_count: 24 },
        { id: "t3", name: "Bloque Norte", unit_count: 16 },
        { id: "t4", name: "Manzana A (Casas)", unit_count: 12 },
    ];

    in-out property <[UnitItem]> units: [
        { id: "u1", tower: "Torre 1", unit_number: "Apto 101", unit_type: "Apartamento", intercom: "Ext. 101", mobile: "300 123 4567", landline: "(604) 444 0001", parking: "P-101" },
        { id: "u2", tower: "Torre 1", unit_number: "Apto 102", unit_type: "Apartamento", intercom: "Sin citófono", mobile: "315 987 6543", landline: "—", parking: "P-102, P-102B" },
        { id: "u3", tower: "Torre 1", unit_number: "Apto 103", unit_type: "Apartamento", intercom: "Ext. 103", mobile: "311 555 8899", landline: "—", parking: "Sin celda" },
        { id: "u4", tower: "Torre 1", unit_number: "Apto 201", unit_type: "Apartamento", intercom: "Ext. 201", mobile: "310 444 3322", landline: "(604) 444 0004", parking: "P-201" },
        { id: "u5", tower: "Torre 1", unit_number: "Apto 202", unit_type: "Apartamento", intercom: "Ext. 202", mobile: "318 777 6655", landline: "—", parking: "P-202" },
        { id: "u6", tower: "Torre 1", unit_number: "Apto 203", unit_type: "Apartamento", intercom: "Sin citófono", mobile: "301 222 1100", landline: "—", parking: "P-203" },
    ];

    callback quick-action(string);
    callback select-tower(string);
    callback register-visit-exit(int);
    callback deliver-package(int);
    callback open-drawer();
    callback cancel-drawer();
    callback save-unit();
    callback open-parking-picker();
    callback close-parking-picker();
    callback search-parking(string);
    callback pick-parking(string);
    callback remove-parking-selection(int);
    callback create-new-parking();

    forward-focus: key-handler;

    key-handler := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                if (root.show-parking-modal) {
                    root.show-parking-modal = false;
                    return accept;
                }
                if (root.show-parking-picker) {
                    root.close-parking-picker();
                    return accept;
                }
                if (root.show-drawer) {
                    root.cancel-drawer();
                    return accept;
                }
            }
            if (event.text == Key.F1) { root.quick-action("home"); return accept; }
            if (event.text == Key.F2) { root.quick-action("visita"); return accept; }
            if (event.text == Key.F3) { root.quick-action("vehiculo"); return accept; }
            if (event.text == Key.F4) { root.quick-action("paquete"); return accept; }
            if (event.text == Key.F5) { root.quick-action("unidades"); return accept; }
            if (event.text == Key.F6) { root.quick-action("minuta"); return accept; }
            return reject;
        }

        // ====================================================================
        // CAPA BASE: VISTA PRINCIPAL
        // ========================================================================
        VerticalLayout {
            padding: 14px;
            spacing: 12px;

            // 1. HEADER NEGRO PURO
            Rectangle {
                height: 58px;
                background: #09090b;
                border-radius: 8px;
                border-width: 1px;
                border-color: #18181b;

                HorizontalLayout {
                    padding-left: 18px;
                    padding-right: 18px;
                    alignment: space-between;

                    HorizontalLayout {
                        spacing: 12px;
                        Text {
                            text: "MAMORI";
                            color: #ffffff;
                            font-size: 20px;
                            font-weight: 900;
                            vertical-alignment: center;
                        }
                        Text {
                            text: "|  CONTROL DE ACCESO Y SEGURIDAD RESIDENCIAL";
                            color: #52525b;
                            font-size: 13px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }

                    HorizontalLayout {
                        spacing: 10px;
                        Rectangle {
                            width: 8px;
                            height: 8px;
                            border-radius: 4px;
                            background: #22c55e;
                            y: 17px;
                        }
                        Text {
                            text: root.status-text;
                            color: #a1a1aa;
                            font-size: 12px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            // 2. CUERPO PRINCIPAL: SIDEBAR IZQUIERDO COLAPSABLE + CONTENIDO ACTIVO
            HorizontalLayout {
                vertical-stretch: 1;
                spacing: 12px;

                // PANEL LATERAL IZQUIERDO COLAPSABLE (MENÚ PRINCIPAL)
                Rectangle {
                    width: root.sidebar-collapsed ? 64px : 230px;
                    animate width { duration: 180ms; easing: ease-out; }
                    clip: true;
                    background: #09090b;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: #18181b;

                    VerticalLayout {
                        padding: 10px;
                        spacing: 6px;

                        // Cabecera del sidebar con botón de colapso
                        HorizontalLayout {
                            height: 32px;
                            padding-left: root.sidebar-collapsed ? 0px : 6px;
                            alignment: root.sidebar-collapsed ? center : space-between;

                            if (!root.sidebar-collapsed): Text {
                                text: "MENÚ PRINCIPAL";
                                color: #71717a;
                                font-size: 11px;
                                font-weight: 800;
                                vertical-alignment: center;
                            }

                            Rectangle {
                                width: 30px;
                                height: 28px;
                                border-radius: 6px;
                                background: toggle-sb-touch.has-hover ? #27272a : #18181b;
                                border-width: 1px;
                                border-color: toggle-sb-touch.has-hover ? #38bdf8 : #27272a;

                                toggle-sb-touch := TouchArea {
                                    clicked => { root.sidebar-collapsed = !root.sidebar-collapsed; }
                                }

                                Text {
                                    text: root.sidebar-collapsed ? "»" : "«";
                                    color: toggle-sb-touch.has-hover ? #ffffff : #a1a1aa;
                                    font-size: 14px;
                                    font-weight: 900;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        Rectangle { height: 1px; background: #18181b; }

                        SidebarNavItem {
                            shortcut: "F1";
                            label: "HOME";
                            active: root.active-module == "home";
                            collapsed: root.sidebar-collapsed;
                            clicked => { root.quick-action("home"); }
                        }
                        SidebarNavItem {
                            shortcut: "F2";
                            label: "VISITAS";
                            active: root.active-module == "visita";
                            collapsed: root.sidebar-collapsed;
                            clicked => { root.quick-action("visita"); }
                        }
                        SidebarNavItem {
                            shortcut: "F3";
                            label: "VEHÍCULOS";
                            active: root.active-module == "vehiculo";
                            collapsed: root.sidebar-collapsed;
                            clicked => { root.quick-action("vehiculo"); }
                        }
                        SidebarNavItem {
                            shortcut: "F4";
                            label: "PAQUETERÍA";
                            active: root.active-module == "paquete";
                            collapsed: root.sidebar-collapsed;
                            clicked => { root.quick-action("paquete"); }
                        }
                        SidebarNavItem {
                            shortcut: "F5";
                            label: "UNIDADES & PREDIOS";
                            active: root.active-module == "unidades";
                            collapsed: root.sidebar-collapsed;
                            clicked => { root.quick-action("unidades"); }
                        }
                        SidebarNavItem {
                            shortcut: "F6";
                            label: "MINUTA & NOVEDADES";
                            active: root.active-module == "minuta";
                            collapsed: root.sidebar-collapsed;
                            clicked => { root.quick-action("minuta"); }
                        }

                        Rectangle { vertical-stretch: 1; }

                        if (!root.sidebar-collapsed): Rectangle {
                            height: 1px;
                            background: #18181b;
                        }
                        if (!root.sidebar-collapsed): Text {
                            text: "MAMORI PORTERÍA";
                            color: #3f3f46;
                            font-size: 10px;
                            font-weight: 800;
                            horizontal-alignment: center;
                        }
                    }
                }

                // ÁREA DE CONTENIDO ACTIVO
                VerticalLayout {
                    horizontal-stretch: 1;
                    vertical-stretch: 1;
                    spacing: 12px;

                    // ================================================================
                    // 3A. VISTA HOME: DASHBOARD OPERATIVO DE PORTERÍA
                    // ================================================================
                    if (root.active-module == "home"): VerticalLayout {
                vertical-stretch: 1;
                spacing: 12px;

                // FILA SUPERIOR: TARJETAS DE RESUMEN OPERATIVO (KPIs)
                HorizontalLayout {
                    vertical-stretch: 0;
                    spacing: 12px;
                    height: 84px;

                    // KPI 1: Visitas dentro de la unidad
                    Rectangle {
                        horizontal-stretch: 1;
                        background: #09090b;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: #18181b;

                        VerticalLayout {
                            padding: 14px;
                            spacing: 4px;
                            HorizontalLayout {
                                alignment: space-between;
                                Text { text: "VISITAS DENTRO DE LA UNIDAD"; color: #71717a; font-size: 11px; font-weight: 800; }
                                Rectangle { width: 8px; height: 8px; border-radius: 4px; background: #38bdf8; y: 3px; }
                            }
                            HorizontalLayout {
                                spacing: 10px;
                                alignment: start;
                                Text { text: root.active-visits.length; color: #ffffff; font-size: 26px; font-weight: 900; vertical-alignment: bottom; }
                                Text { text: "activas en este momento"; color: #38bdf8; font-size: 11px; font-weight: 600; vertical-alignment: bottom; }
                            }
                        }
                    }

                    // KPI 2: Paquetería pendiente
                    Rectangle {
                        horizontal-stretch: 1;
                        background: #09090b;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: #18181b;

                        VerticalLayout {
                            padding: 14px;
                            spacing: 4px;
                            HorizontalLayout {
                                alignment: space-between;
                                Text { text: "PAQUETERÍA PENDIENTE"; color: #71717a; font-size: 11px; font-weight: 800; }
                                Rectangle { width: 8px; height: 8px; border-radius: 4px; background: #f59e0b; y: 3px; }
                            }
                            HorizontalLayout {
                                spacing: 10px;
                                alignment: start;
                                Text { text: root.pending-packages.length; color: #ffffff; font-size: 26px; font-weight: 900; vertical-alignment: bottom; }
                                Text { text: "en casillero de portería"; color: #fbbf24; font-size: 11px; font-weight: 600; vertical-alignment: bottom; }
                            }
                        }
                    }

                    // KPI 3: Unidades registradas
                    Rectangle {
                        horizontal-stretch: 1;
                        background: #09090b;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: #18181b;

                        VerticalLayout {
                            padding: 14px;
                            spacing: 4px;
                            HorizontalLayout {
                                alignment: space-between;
                                Text { text: "UNIDADES REGISTRADAS"; color: #71717a; font-size: 11px; font-weight: 800; }
                                Rectangle { width: 8px; height: 8px; border-radius: 4px; background: #22c55e; y: 3px; }
                            }
                            HorizontalLayout {
                                spacing: 10px;
                                alignment: start;
                                Text { text: root.units.length; color: #ffffff; font-size: 26px; font-weight: 900; vertical-alignment: bottom; }
                                Text { text: "predios en directorio"; color: #4ade80; font-size: 11px; font-weight: 600; vertical-alignment: bottom; }
                            }
                        }
                    }
                }

                // PANEL PRINCIPAL DIVIDIDO: VISITAS ACTIVAS | PAQUETERÍA PENDIENTE
                HorizontalLayout {
                    vertical-stretch: 1;
                    spacing: 12px;

                    // COLUMNA IZQUIERDA: VISITAS DENTRO DE LA UNIDAD
                    Rectangle {
                        horizontal-stretch: 1;
                        background: #09090b;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: #18181b;

                        VerticalLayout {
                            padding: 16px;
                            spacing: 10px;

                            HorizontalLayout {
                                vertical-stretch: 0;
                                alignment: space-between;
                                VerticalLayout {
                                    spacing: 2px;
                                    Text {
                                        text: "VISITAS DENTRO DE LA UNIDAD";
                                        color: #ffffff;
                                        font-size: 14px;
                                        font-weight: 900;
                                    }
                                    Text {
                                        text: "Personas actualmente dentro de la copropiedad sin registro de salida";
                                        color: #71717a;
                                        font-size: 11px;
                                        font-weight: 500;
                                    }
                                }
                                CompactActionButton {
                                    text: "IR A VISITAS";
                                    clicked => { root.quick-action("visita"); }
                                }
                            }

                            Rectangle { height: 1px; background: #18181b; }

                            // Cabecera de tabla
                            Rectangle {
                                height: 30px;
                                background: #050507;
                                border-radius: 4px;
                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    spacing: 8px;
                                    Text { text: "VISITANTE"; horizontal-stretch: 2; color: #71717a; font-size: 10px; font-weight: 800; vertical-alignment: center; }
                                    Text { text: "DESTINO"; horizontal-stretch: 2; color: #71717a; font-size: 10px; font-weight: 800; vertical-alignment: center; }
                                    Text { text: "INGRESO"; width: 58px; color: #71717a; font-size: 10px; font-weight: 800; vertical-alignment: center; }
                                    Text { text: "ACCIÓN"; width: 92px; color: #71717a; font-size: 10px; font-weight: 800; vertical-alignment: center; horizontal-alignment: right; }
                                }
                            }

                            if (root.active-visits.length == 0): Rectangle {
                                vertical-stretch: 1;
                                background: #050507;
                                border-radius: 6px;
                                border-width: 1px;
                                border-color: #18181b;
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 4px;
                                    Text {
                                        text: "No hay visitantes dentro de la unidad";
                                        color: #a1a1aa;
                                        font-size: 13px;
                                        font-weight: 700;
                                        horizontal-alignment: center;
                                    }
                                    Text {
                                        text: "Todas las visitas registradas ya completaron su salida";
                                        color: #52525b;
                                        font-size: 11px;
                                        horizontal-alignment: center;
                                    }
                                }
                            }

                            if (root.active-visits.length > 0): ScrollView {
                                vertical-stretch: 1;
                                VerticalLayout {
                                    alignment: start;
                                    spacing: 6px;
                                    for visit[idx] in root.active-visits: Rectangle {
                                        height: 54px;
                                        background: #050507;
                                        border-radius: 6px;
                                        border-width: 1px;
                                        border-color: #18181b;

                                        HorizontalLayout {
                                            padding-left: 12px;
                                            padding-right: 12px;
                                            spacing: 8px;

                                            VerticalLayout {
                                                horizontal-stretch: 2;
                                                alignment: center;
                                                spacing: 2px;
                                                Text { text: visit.visitor-name; color: #ffffff; font-size: 12px; font-weight: 800; }
                                                Text { text: visit.document + " • " + visit.access-type; color: #71717a; font-size: 10px; font-weight: 600; }
                                            }

                                            VerticalLayout {
                                                horizontal-stretch: 2;
                                                alignment: center;
                                                Text { text: visit.destination; color: #38bdf8; font-size: 12px; font-weight: 700; }
                                            }

                                            Text {
                                                text: visit.entry-time;
                                                width: 58px;
                                                color: #e4e4e7;
                                                font-size: 12px;
                                                font-weight: 700;
                                                vertical-alignment: center;
                                            }

                                            VerticalLayout {
                                                width: 92px;
                                                alignment: center;
                                                CompactActionButton {
                                                    text: "DAR SALIDA";
                                                    clicked => { root.register-visit-exit(idx); }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // COLUMNA DERECHA: PAQUETERÍA PENDIENTE POR ENTREGAR
                    Rectangle {
                        horizontal-stretch: 1;
                        background: #09090b;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: #18181b;

                        VerticalLayout {
                            padding: 16px;
                            spacing: 10px;

                            HorizontalLayout {
                                vertical-stretch: 0;
                                alignment: space-between;
                                VerticalLayout {
                                    spacing: 2px;
                                    Text {
                                        text: "PAQUETERÍA PENDIENTE POR ENTREGAR";
                                        color: #ffffff;
                                        font-size: 14px;
                                        font-weight: 900;
                                    }
                                    Text {
                                        text: "Encomiendas recibidas en garita esperando reclamo del residente";
                                        color: #71717a;
                                        font-size: 11px;
                                        font-weight: 500;
                                    }
                                }
                                CompactActionButton {
                                    text: "IR A PAQUETERÍA";
                                    clicked => { root.quick-action("paquete"); }
                                }
                            }

                            Rectangle { height: 1px; background: #18181b; }

                            // Cabecera de tabla
                            Rectangle {
                                height: 30px;
                                background: #050507;
                                border-radius: 4px;
                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    spacing: 8px;
                                    Text { text: "DESTINO / RESIDENTE"; horizontal-stretch: 2; color: #71717a; font-size: 10px; font-weight: 800; vertical-alignment: center; }
                                    Text { text: "EMPRESA / DETALLE"; horizontal-stretch: 2; color: #71717a; font-size: 10px; font-weight: 800; vertical-alignment: center; }
                                    Text { text: "RECIBIDO"; width: 58px; color: #71717a; font-size: 10px; font-weight: 800; vertical-alignment: center; }
                                    Text { text: "ACCIÓN"; width: 92px; color: #71717a; font-size: 10px; font-weight: 800; vertical-alignment: center; horizontal-alignment: right; }
                                }
                            }

                            if (root.pending-packages.length == 0): Rectangle {
                                vertical-stretch: 1;
                                background: #050507;
                                border-radius: 6px;
                                border-width: 1px;
                                border-color: #18181b;
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 4px;
                                    Text {
                                        text: "Sin paquetería pendiente por entregar";
                                        color: #a1a1aa;
                                        font-size: 13px;
                                        font-weight: 700;
                                        horizontal-alignment: center;
                                    }
                                    Text {
                                        text: "El casillero de portería se encuentra al día";
                                        color: #52525b;
                                        font-size: 11px;
                                        horizontal-alignment: center;
                                    }
                                }
                            }

                            if (root.pending-packages.length > 0): ScrollView {
                                vertical-stretch: 1;
                                VerticalLayout {
                                    alignment: start;
                                    spacing: 6px;
                                    for pkg[idx] in root.pending-packages: Rectangle {
                                        height: 54px;
                                        background: #050507;
                                        border-radius: 6px;
                                        border-width: 1px;
                                        border-color: #18181b;

                                        HorizontalLayout {
                                            padding-left: 12px;
                                            padding-right: 12px;
                                            spacing: 8px;

                                            VerticalLayout {
                                                horizontal-stretch: 2;
                                                alignment: center;
                                                spacing: 2px;
                                                Text { text: pkg.destination; color: #fbbf24; font-size: 12px; font-weight: 800; }
                                                Text { text: pkg.recipient; color: #a1a1aa; font-size: 10px; font-weight: 600; }
                                            }

                                            VerticalLayout {
                                                horizontal-stretch: 2;
                                                alignment: center;
                                                spacing: 2px;
                                                Text { text: pkg.carrier; color: #ffffff; font-size: 12px; font-weight: 700; }
                                                Text { text: pkg.description; color: #71717a; font-size: 10px; font-weight: 600; }
                                            }

                                            Text {
                                                text: pkg.received-time;
                                                width: 58px;
                                                color: #e4e4e7;
                                                font-size: 12px;
                                                font-weight: 700;
                                                vertical-alignment: center;
                                            }

                                            VerticalLayout {
                                                width: 92px;
                                                alignment: center;
                                                CompactActionButton {
                                                    text: "ENTREGAR";
                                                    positive: true;
                                                    clicked => { root.deliver-package(idx); }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // ================================================================
            // 3B. CUERPO PRINCIPAL: GESTIÓN DE UNIDADES
            // ================================================================
            if (root.active-module == "unidades"): HorizontalLayout {
                vertical-stretch: 1;
                spacing: 12px;

                // PANEL IZQUIERDO: TORRES Y PARQUEADEROS
                Rectangle {
                    width: 270px;
                    background: #09090b;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: #18181b;

                    VerticalLayout {
                        padding: 14px;
                        spacing: 10px;

                        HorizontalLayout {
                            alignment: space-between;
                            Text {
                                text: "TORRES / BLOQUES";
                                color: #71717a;
                                font-size: 12px;
                                font-weight: 800;
                                vertical-alignment: center;
                            }
                        }

                        Rectangle { height: 1px; background: #18181b; }

                        for tower in root.towers: Rectangle {
                            height: 48px;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: root.selected-tower == tower.name ? #38bdf8 : #18181b;
                            background: root.selected-tower == tower.name ? #111827 : (tower-touch.has-hover ? #141417 : #050507);

                            tower-touch := TouchArea {
                                clicked => {
                                    root.selected-tower = tower.name;
                                    root.select-tower(tower.name);
                                }
                            }

                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                alignment: space-between;

                                Text {
                                    text: tower.name;
                                    color: root.selected-tower == tower.name ? #38bdf8 : #f4f4f5;
                                    font-size: 14px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }

                                Rectangle {
                                    width: 68px;
                                    height: 22px;
                                    border-radius: 11px;
                                    background: #18181b;
                                    y: 13px;

                                    Text {
                                        text: tower.unit_count + " aptos";
                                        color: #a1a1aa;
                                        font-size: 11px;
                                        font-weight: 600;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }

                        Rectangle { height: 6px; }

                        TacticalButton {
                            text: "NUEVA TORRE / BLOQUE";
                            h-stretch: 1;
                            clicked => {
                                root.status-text = "Iniciando creación de nueva torre...";
                            }
                        }

                        Rectangle { height: 10px; }
                        Rectangle { height: 1px; background: #18181b; }

                        // SECCIÓN RÁPIDA: PARQUEADEROS
                        Text {
                            text: "PARQUEADEROS COPROPIEDAD";
                            color: #71717a;
                            font-size: 11px;
                            font-weight: 800;
                        }

                        TacticalButton {
                            text: "CREAR PARQUEADERO";
                            h-stretch: 1;
                            clicked => {
                                root.show-parking-modal = true;
                            }
                        }
                    }
                }

                // PANEL DERECHO: DIRECTORIO DE INMUEBLES
                Rectangle {
                    background: #09090b;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: #18181b;

                    VerticalLayout {
                        padding: 16px;
                        spacing: 12px;

                        HorizontalLayout {
                            alignment: space-between;

                            HorizontalLayout {
                                spacing: 12px;
                                Text {
                                    text: root.selected-tower;
                                    color: #ffffff;
                                    font-size: 18px;
                                    font-weight: 800;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: "•  Directorio de Inmuebles Registrados";
                                    color: #71717a;
                                    font-size: 13px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                            }

                            TacticalButton {
                                text: "NUEVO INMUEBLE";
                                primary: true;
                                clicked => {
                                    root.open-drawer();
                                }
                            }
                        }

                        Rectangle { height: 1px; background: #18181b; }

                        // TABLA DE INMUEBLES
                        VerticalLayout {
                            spacing: 3px;

                            Rectangle {
                                height: 36px;
                                background: #000000;
                                border-radius: 4px;
                                border-width: 1px;
                                border-color: #18181b;

                                HorizontalLayout {
                                    padding-left: 14px;
                                    padding-right: 14px;

                                    Text { text: "INMUEBLE"; width: 110px; color: #71717a; font-size: 11px; font-weight: 800; vertical-alignment: center; }
                                    Text { text: "TIPO"; width: 120px; color: #71717a; font-size: 11px; font-weight: 800; vertical-alignment: center; }
                                    Text { text: "CITÓFONO / EXT."; width: 140px; color: #71717a; font-size: 11px; font-weight: 800; vertical-alignment: center; }
                                    Text { text: "CELULAR"; width: 140px; color: #71717a; font-size: 11px; font-weight: 800; vertical-alignment: center; }
                                    Text { text: "TEL. FIJO"; width: 120px; color: #71717a; font-size: 11px; font-weight: 800; vertical-alignment: center; }
                                    Text { text: "PARQUEADEROS PRIVADOS"; color: #71717a; font-size: 11px; font-weight: 800; vertical-alignment: center; }
                                }
                            }

                            for unit in root.units: Rectangle {
                                height: 42px;
                                background: #050507;
                                border-radius: 4px;
                                border-width: 1px;
                                border-color: #141417;

                                HorizontalLayout {
                                    padding-left: 14px;
                                    padding-right: 14px;

                                    Text { text: unit.unit-number; width: 110px; color: #ffffff; font-size: 13px; font-weight: 800; vertical-alignment: center; }
                                    Text { text: unit.unit-type; width: 120px; color: #a1a1aa; font-size: 13px; vertical-alignment: center; }
                                    
                                    HorizontalLayout {
                                        width: 140px;
                                        spacing: 6px;
                                        Rectangle {
                                            width: 6px;
                                            height: 6px;
                                            border-radius: 3px;
                                            background: unit.intercom == "Sin citófono" ? #ef4444 : #22c55e;
                                            y: 18px;
                                        }
                                        Text {
                                            text: unit.intercom;
                                            color: unit.intercom == "Sin citófono" ? #f87171 : #4ade80;
                                            font-size: 12px;
                                            font-weight: 700;
                                            vertical-alignment: center;
                                        }
                                    }

                                    Text { text: unit.mobile; width: 140px; color: #e4e4e7; font-size: 13px; font-weight: 600; vertical-alignment: center; }
                                    Text { text: unit.landline; width: 120px; color: #71717a; font-size: 13px; vertical-alignment: center; }
                                    
                                    Text {
                                        text: unit.parking;
                                        color: unit.parking == "Sin celda" ? #52525b : #38bdf8;
                                        font-size: 13px;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // ================================================================
            // 3C. VISTAS EN CONSTRUCCIÓN (VISITAS, VEHÍCULOS, PAQUETERÍA, MINUTA)
            // ================================================================
            if (root.active-module != "home" && root.active-module != "unidades"): Rectangle {
                vertical-stretch: 1;
                background: #09090b;
                border-radius: 8px;
                border-width: 1px;
                border-color: #18181b;

                VerticalLayout {
                    alignment: center;
                    spacing: 12px;

                    Text {
                        text: "MÓDULO EN CONSTRUCCIÓN: " + root.active-module;
                        color: #ffffff;
                        font-size: 18px;
                        font-weight: 900;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: "Este módulo será especificado e implementado en la siguiente iteración.";
                        color: #71717a;
                        font-size: 13px;
                        horizontal-alignment: center;
                    }
                    HorizontalLayout {
                        alignment: center;
                        TacticalButton {
                            text: "VOLVER A HOME [F1]";
                            active: true;
                            clicked => { root.quick-action("home"); }
                        }
                    }
                }
            }
                }
            }

            // 4. FOOTER TÁCTICO INFERIOR
            HorizontalLayout {
                alignment: space-between;
                Text {
                    text: "ATAJOS: [F1] HOME | [F2] VISITAS | [F3] VEHÍCULOS | [F4] PAQUETERÍA | [F5] UNIDADES | [F6] MINUTA | [ESC] CERRAR PANEL";
                    color: #52525b;
                    font-size: 11px;
                    font-weight: 700;
                }
                Text {
                    text: "MAMORI v0.1.0 — TERMINAL NATIVA DE PORTERÍA (SLINT / RUST)";
                    color: #52525b;
                    font-size: 11px;
                    font-weight: 700;
                }
            }
        }
    }

    // ========================================================================
    // CAPA LATERAL: PANEL DERECHO (DRAWER DE NUEVO INMUEBLE)
    // ========================================================================
    if (root.show-drawer): Rectangle {
        width: 100%;
        height: 100%;
        background: #000000a6;

        TouchArea {
            clicked => { root.cancel-drawer(); }
        }

        Rectangle {
            x: parent.width - self.width;
            y: 0;
            width: 500px;
            height: parent.height;
            background: #09090b;
            border-width: 1px;
            border-color: #27272a;

            TouchArea {
                clicked => { /* Absorbe clics internos */ }
            }

            drawer-scope := FocusScope {
                key-pressed(event) => {
                    if (event.text == Key.Escape) {
                        if (root.show-parking-picker) {
                            root.close-parking-picker();
                            return accept;
                        }
                        root.cancel-drawer();
                        return accept;
                    }
                    return reject;
                }

                VerticalLayout {
                    padding: 22px;
                    spacing: 14px;

                    // CABECERA DEL PANEL
                    HorizontalLayout {
                        alignment: space-between;

                        VerticalLayout {
                            spacing: 2px;
                            Text {
                                text: "NUEVO INMUEBLE";
                                color: #ffffff;
                                font-size: 18px;
                                font-weight: 900;
                            }
                            Text {
                                text: "Torre destino: " + root.selected-tower;
                                color: #38bdf8;
                                font-size: 13px;
                                font-weight: 600;
                            }
                        }

                        Rectangle {
                            width: 32px;
                            height: 32px;
                            border-radius: 16px;
                            background: close-touch.has-hover ? #27272a : #18181b;

                            close-touch := TouchArea {
                                clicked => { root.cancel-drawer(); }
                            }

                            Text {
                                text: "✕";
                                color: #a1a1aa;
                                font-size: 14px;
                                font-weight: 800;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }

                    Rectangle { height: 1px; background: #18181b; }

                    // CAMPOS BASE
                    VerticalLayout {
                        vertical-stretch: 0;
                        spacing: 12px;

                        VerticalLayout {
                            vertical-stretch: 0;
                            spacing: 4px;
                            Text { text: "NÚMERO DE INMUEBLE / PREDIO:"; color: #a1a1aa; font-size: 11px; font-weight: 800; }
                            LineEdit {
                                height: 36px;
                                vertical-stretch: 0;
                                horizontal-stretch: 1;
                                text <=> root.form-unit-number;
                                placeholder-text: "Ej: 301, 102A, Casa 15";
                            }
                        }

                        VerticalLayout {
                            vertical-stretch: 0;
                            spacing: 4px;
                            Text { text: "CITÓFONO / EXTENSIÓN FÍSICA:"; color: #a1a1aa; font-size: 11px; font-weight: 800; }
                            LineEdit {
                                height: 36px;
                                vertical-stretch: 0;
                                horizontal-stretch: 1;
                                text <=> root.form-intercom;
                                placeholder-text: "Ej: Ext. 301 o 'Sin citófono'";
                            }
                        }

                        VerticalLayout {
                            vertical-stretch: 0;
                            spacing: 4px;
                            Text { text: "CELULAR:"; color: #a1a1aa; font-size: 11px; font-weight: 800; }
                            LineEdit {
                                height: 36px;
                                vertical-stretch: 0;
                                horizontal-stretch: 1;
                                text <=> root.form-mobile;
                                placeholder-text: "Ej: 300 123 4567";
                            }
                        }

                        VerticalLayout {
                            vertical-stretch: 0;
                            spacing: 4px;
                            Text { text: "TELÉFONO FIJO (OPCIONAL):"; color: #a1a1aa; font-size: 11px; font-weight: 800; }
                            LineEdit {
                                height: 36px;
                                vertical-stretch: 0;
                                horizontal-stretch: 1;
                                text <=> root.form-landline;
                                placeholder-text: "Ej: (604) 444 0000";
                            }
                        }
                    }

                    Rectangle { height: 1px; background: #18181b; }

                    // ========================================================
                    // SECCIÓN DE PARQUEADEROS PRIVADOS ASIGNADOS
                    // ========================================================
                    VerticalLayout {
                        vertical-stretch: 0;
                        spacing: 8px;

                        HorizontalLayout {
                            alignment: space-between;
                            Text {
                                text: "PARQUEADEROS PRIVADOS ASIGNADOS:";
                                color: #38bdf8;
                                font-size: 11px;
                                font-weight: 800;
                                vertical-alignment: center;
                            }

                            // Botón para crear nueva bahía en la copropiedad
                            TouchArea {
                                width: 140px;
                                height: 24px;
                                clicked => { root.show-parking-modal = true; }

                                Text {
                                    text: "NUEVO PARQUEADERO";
                                    color: #22c55e;
                                    font-size: 10px;
                                    font-weight: 800;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        // Lista de celdas asignadas al inmueble
                        if (root.selected-parking-list.length == 0): Rectangle {
                            height: 38px;
                            background: #050507;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: #18181b;

                            HorizontalLayout {
                                padding-left: 14px;
                                Text {
                                    text: "Ningún parqueadero asignado a este predio";
                                    color: #52525b;
                                    font-size: 12px;
                                    font-weight: 500;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        for spot-val[idx] in root.selected-parking-list: Rectangle {
                            height: 38px;
                            background: #050507;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: #27272a;

                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 8px;
                                alignment: space-between;

                                HorizontalLayout {
                                    spacing: 8px;
                                    Rectangle {
                                        width: 6px;
                                        height: 6px;
                                        border-radius: 3px;
                                        background: #38bdf8;
                                        y: 16px;
                                    }
                                    Text {
                                        text: spot-val;
                                        color: #ffffff;
                                        font-size: 13px;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    DeleteButton {
                                        clicked => {
                                            root.remove-parking-selection(idx);
                                        }
                                    }
                                }
                            }
                        }

                        // Botón para abrir el panel de asignación
                        TacticalButton {
                            text: "ASIGNAR PARQUEADERO";
                            h-stretch: 1;
                            font-size: 12px;
                            active: root.show-parking-picker;
                            clicked => {
                                root.open-parking-picker();
                            }
                        }
                    }

                    Rectangle { vertical-stretch: 1; }
                    Rectangle { height: 1px; background: #18181b; }

                    // BOTONES DE ACCIÓN INFERIORES
                    VerticalLayout {
                        vertical-stretch: 0;
                        spacing: 8px;

                        TacticalButton {
                            text: "GUARDAR INMUEBLE";
                            primary: true;
                            h-stretch: 1;
                            font-size: 13px;
                            clicked => {
                                root.save-unit();
                            }
                        }

                        TacticalButton {
                            text: "CANCELAR [ESC]";
                            h-stretch: 1;
                            font-size: 12px;
                            clicked => {
                                root.cancel-drawer();
                            }
                        }
                    }
                }

                // ============================================================
                // SUB-PANEL INFERIOR: BÚSQUEDA Y ASIGNACIÓN DE PARQUEADEROS
                // ============================================================
                if (root.show-parking-picker): Rectangle {
                    x: 0;
                    y: parent.height - self.height;
                    width: parent.width;
                    height: 440px;
                    background: #09090b;
                    border-width: 1px;
                    border-color: #38bdf8;
                    border-radius: 8px;

                    TouchArea { clicked => { /* Absorbe clics internos */ } }

                    VerticalLayout {
                        padding: 16px;
                        spacing: 10px;

                        // CABECERA
                        HorizontalLayout {
                            alignment: space-between;

                            VerticalLayout {
                                spacing: 2px;
                                Text {
                                    text: "PARQUEADEROS DISPONIBLES";
                                    color: #ffffff;
                                    font-size: 14px;
                                    font-weight: 900;
                                }
                                Text {
                                    text: "Seleccione una celda para asignarla a este inmueble";
                                    color: #a1a1aa;
                                    font-size: 11px;
                                    font-weight: 500;
                                }
                            }

                            Rectangle {
                                width: 28px;
                                height: 28px;
                                border-radius: 14px;
                                background: picker-close-touch.has-hover ? #27272a : #18181b;

                                picker-close-touch := TouchArea {
                                    clicked => { root.close-parking-picker(); }
                                }

                                Text {
                                    text: "✕";
                                    color: #a1a1aa;
                                    font-size: 13px;
                                    font-weight: 800;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        Rectangle { height: 1px; background: #27272a; }

                        // BUSCADOR EN TIEMPO REAL
                        VerticalLayout {
                            vertical-stretch: 0;
                            spacing: 4px;
                            Text {
                                text: "BUSCADOR DE CELDAS:";
                                color: #38bdf8;
                                font-size: 10px;
                                font-weight: 800;
                            }
                            LineEdit {
                                height: 36px;
                                vertical-stretch: 0;
                                horizontal-stretch: 1;
                                text <=> root.parking-search-query;
                                placeholder-text: "Buscar por código (ej: P-105) o tipo (Carro / Moto)...";
                                edited(q) => {
                                    root.search-parking(q);
                                }
                            }
                        }

                        // LISTA DE RESULTADOS
                        if (root.filtered-parking-options.length == 0): Rectangle {
                            vertical-stretch: 1;
                            background: #050507;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: #18181b;

                            VerticalLayout {
                                alignment: center;
                                spacing: 4px;
                                Text {
                                    text: "No se encontraron parqueaderos disponibles";
                                    color: #a1a1aa;
                                    font-size: 12px;
                                    font-weight: 700;
                                    horizontal-alignment: center;
                                }
                                Text {
                                    text: "Verifique el término de búsqueda o cree una nueva bahía";
                                    color: #52525b;
                                    font-size: 11px;
                                    horizontal-alignment: center;
                                }
                            }
                        }

                        if (root.filtered-parking-options.length > 0): ScrollView {
                            vertical-stretch: 1;
                            VerticalLayout {
                                alignment: start;
                                spacing: 6px;
                                for item in root.filtered-parking-options: Rectangle {
                                    height: 40px;
                                    background: spot-item-touch.has-hover ? #18181b : #050507;
                                    border-radius: 6px;
                                    border-width: 1px;
                                    border-color: spot-item-touch.has-hover ? #38bdf8 : #27272a;

                                    spot-item-touch := TouchArea {
                                        clicked => {
                                            root.pick-parking(item.display-name);
                                        }
                                    }

                                    HorizontalLayout {
                                        padding-left: 14px;
                                        padding-right: 14px;
                                        alignment: space-between;

                                        HorizontalLayout {
                                            spacing: 10px;
                                            Text {
                                                text: item.code;
                                                color: #ffffff;
                                                font-size: 13px;
                                                font-weight: 800;
                                                vertical-alignment: center;
                                            }
                                            Rectangle {
                                                width: 60px;
                                                height: 20px;
                                                border-radius: 4px;
                                                background: item.spot-type == "Moto" ? #3b0764 : #0c4a6e;
                                                border-width: 1px;
                                                border-color: item.spot-type == "Moto" ? #a855f7 : #38bdf8;
                                                y: 10px;

                                                Text {
                                                    text: item.spot-type;
                                                    color: item.spot-type == "Moto" ? #d8b4fe : #7dd3fc;
                                                    font-size: 10px;
                                                    font-weight: 800;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }

                                        Text {
                                            text: "ASIGNAR ↵";
                                            color: spot-item-touch.has-hover ? #22c55e : #71717a;
                                            font-size: 11px;
                                            font-weight: 800;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }

                        TacticalButton {
                            text: "CERRAR LISTA [ESC]";
                            h-stretch: 1;
                            font-size: 11px;
                            clicked => {
                                root.close-parking-picker();
                            }
                        }
                    }
                }
            }
        }
    }

    // ========================================================================
    // CAPA LATERAL: PANEL DERECHO (DRAWER DE NUEVO PARQUEADERO)
    // ========================================================================
    if (root.show-parking-modal): Rectangle {
        width: 100%;
        height: 100%;
        background: #000000a6;

        TouchArea {
            clicked => { root.show-parking-modal = false; }
        }

        Rectangle {
            x: parent.width - self.width;
            y: 0;
            width: 500px;
            height: parent.height;
            background: #09090b;
            border-width: 1px;
            border-color: #27272a;

            TouchArea {
                clicked => { /* Absorbe clics internos */ }
            }

            parking-drawer-scope := FocusScope {
                key-pressed(event) => {
                    if (event.text == Key.Escape) {
                        root.show-parking-modal = false;
                        return accept;
                    }
                    return reject;
                }

                VerticalLayout {
                    padding: 22px;
                    spacing: 14px;

                    // CABECERA DEL PANEL
                    HorizontalLayout {
                        alignment: space-between;

                        VerticalLayout {
                            spacing: 2px;
                            Text {
                                text: "NUEVO PARQUEADERO";
                                color: #ffffff;
                                font-size: 18px;
                                font-weight: 900;
                            }
                            Text {
                                text: "Catálogo de bahías de la copropiedad";
                                color: #38bdf8;
                                font-size: 13px;
                                font-weight: 600;
                            }
                        }

                        Rectangle {
                            width: 32px;
                            height: 32px;
                            border-radius: 16px;
                            background: close-pk-touch.has-hover ? #27272a : #18181b;

                            close-pk-touch := TouchArea {
                                clicked => { root.show-parking-modal = false; }
                            }

                            Text {
                                text: "✕";
                                color: #a1a1aa;
                                font-size: 14px;
                                font-weight: 800;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }

                    Rectangle { height: 1px; background: #18181b; }

                    // CAMPOS DEL PARQUEADERO
                    VerticalLayout {
                        vertical-stretch: 0;
                        spacing: 12px;

                        VerticalLayout {
                            vertical-stretch: 0;
                            spacing: 5px;
                            Text { text: "CÓDIGO / IDENTIFICADOR DE BAHÍA:"; color: #a1a1aa; font-size: 11px; font-weight: 800; }
                            LineEdit {
                                height: 36px;
                                vertical-stretch: 0;
                                horizontal-stretch: 1;
                                text <=> root.form-parking-code;
                                placeholder-text: "Ej: P-107, Celda M-05";
                            }
                        }

                        VerticalLayout {
                            vertical-stretch: 0;
                            spacing: 5px;
                            Text { text: "TIPO DE VEHÍCULO:"; color: #a1a1aa; font-size: 11px; font-weight: 800; }
                            HorizontalLayout {
                                spacing: 8px;
                                TacticalButton {
                                    text: "CARRO";
                                    h-stretch: 1;
                                    active: root.form-parking-type == "Carro";
                                    clicked => { root.form-parking-type = "Carro"; }
                                }
                                TacticalButton {
                                    text: "MOTO";
                                    h-stretch: 1;
                                    active: root.form-parking-type == "Moto";
                                    clicked => { root.form-parking-type = "Moto"; }
                                }
                            }
                        }
                    }

                    Rectangle { vertical-stretch: 1; }
                    Rectangle { height: 1px; background: #18181b; }

                    // BOTONES DE ACCIÓN INFERIORES
                    VerticalLayout {
                        vertical-stretch: 0;
                        spacing: 8px;

                        TacticalButton {
                            text: "GUARDAR PARQUEADERO";
                            primary: true;
                            h-stretch: 1;
                            font-size: 13px;
                            clicked => {
                                root.create-new-parking();
                            }
                        }

                        TacticalButton {
                            text: "CANCELAR [ESC]";
                            h-stretch: 1;
                            font-size: 12px;
                            clicked => {
                                root.show-parking-modal = false;
                            }
                        }
                    }
                }
            }
        }
    }
}
