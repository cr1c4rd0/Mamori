import { LineEdit, ScrollView } from "std-widgets.slint";

// ============================================================================
// COMPONENTES TÁCTICOS CON ESTILO NEGRO PURO Y AUTO-AJUSTE DINÁMICO
// ============================================================================

component TacticalButton inherits Rectangle {
    in property <string> text;
    in property <bool> active: false;
    in property <bool> primary: false;
    in property <length> font-size: 13px;
    in property <int> h-stretch: 0;
    callback clicked;

    horizontal-stretch: root.h-stretch;
    height: 38px;
    min-width: txt.min-width + 24px;
    border-radius: 6px;
    border-width: 1px;
    border-color: root.active ? #38bdf8 : (root.primary ? #22c55e : (touch.has-hover ? #3f3f46 : #27272a));
    background: root.active ? #0c4a6e : (root.primary ? #14532d : (touch.has-hover ? #18181b : #09090b));

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        alignment: center;

        txt := Text {
            text: root.text;
            color: root.active ? #ffffff : (root.primary ? #4ade80 : (touch.has-hover ? #fafafa : #a1a1aa));
            font-size: root.font-size;
            font-weight: 700;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }
}

// Estructuras de datos para Slint
export struct UnitItem {
    id: string,
    tower: string,
    unit_number: string,
    unit_type: string,
    intercom: string,
    mobile: string,
    landline: string,
    parking: string,
}

export struct TowerItem {
    id: string,
    name: string,
    unit_count: int,
}

// ============================================================================
// VENTANA PRINCIPAL — MAMORI BLACK EDITION CON VENTANA MODAL FLOTANTE
// ============================================================================
export component AppWindow inherits Window {
    title: "MAMORI — Terminal de Portería (Black Edition)";
    preferred-width: 1150px;
    preferred-height: 760px;
    min-width: 950px;
    min-height: 680px;
    background: #000000; // NEGRO PURO

    in-out property <string> active-module: "unidades";
    in-out property <string> status-text: "SISTEMA OPERATIVO | BASE DE DATOS LOCAL SINCRONIZADA";
    in-out property <string> selected-tower: "Torre 1";
    in-out property <bool> show-modal: false;

    // Campos del formulario modal
    in-out property <string> form-unit-number: "";
    in-out property <string> form-unit-type: "Apartamento";
    in-out property <string> form-intercom: "";
    in-out property <string> form-mobile: "";
    in-out property <string> form-landline: "";
    in-out property <string> form-parking: "";

    // Listas reactivas
    in-out property <[TowerItem]> towers: [
        { id: "t1", name: "Torre 1", unit_count: 24 },
        { id: "t2", name: "Torre 2", unit_count: 24 },
        { id: "t3", name: "Bloque Norte", unit_count: 16 },
        { id: "t4", name: "Manzana A (Casas)", unit_count: 12 },
    ];

    in-out property <[UnitItem]> units: [
        { id: "u1", tower: "Torre 1", unit_number: "Apto 101", unit_type: "Apartamento", intercom: "Ext. 101", mobile: "300 123 4567", landline: "(604) 444 0001", parking: "P-101" },
        { id: "u2", tower: "Torre 1", unit_number: "Apto 102", unit_type: "Apartamento", intercom: "Sin citófono", mobile: "315 987 6543", landline: "—", parking: "P-102, P-102B" },
        { id: "u3", tower: "Torre 1", unit_number: "Apto 103", unit_type: "Apartamento", intercom: "Ext. 103", mobile: "311 555 8899", landline: "—", parking: "Sin celda" },
        { id: "u4", tower: "Torre 1", unit_number: "Apto 201", unit_type: "Apartamento", intercom: "Ext. 201", mobile: "310 444 3322", landline: "(604) 444 0004", parking: "P-201" },
        { id: "u5", tower: "Torre 1", unit_number: "Apto 202", unit_type: "Apartamento", intercom: "Ext. 202", mobile: "318 777 6655", landline: "—", parking: "P-202" },
        { id: "u6", tower: "Torre 1", unit_number: "Apto 203", unit_type: "Apartamento", intercom: "Sin citófono", mobile: "301 222 1100", landline: "—", parking: "P-203" },
    ];

    callback quick-action(string);
    callback select-tower(string);
    callback save-unit();

    // ========================================================================
    // CAPA BASE: VISTA PRINCIPAL
    // ========================================================================
    VerticalLayout {
        padding: 14px;
        spacing: 12px;

        // 1. HEADER NEGRO PURO
        Rectangle {
            height: 58px;
            background: #09090b;
            border-radius: 8px;
            border-width: 1px;
            border-color: #18181b;

            HorizontalLayout {
                padding-left: 18px;
                padding-right: 18px;
                alignment: space-between;

                HorizontalLayout {
                    spacing: 12px;
                    Text {
                        text: "🛡️ MAMORI";
                        color: #ffffff;
                        font-size: 20px;
                        font-weight: 900;
                        vertical-alignment: center;
                    }
                    Text {
                        text: "|  CONTROL DE ACCESO Y SEGURIDAD RESIDENCIAL";
                        color: #52525b;
                        font-size: 13px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }

                HorizontalLayout {
                    spacing: 10px;
                    Rectangle {
                        width: 8px;
                        height: 8px;
                        border-radius: 4px;
                        background: #22c55e;
                        y: 17px;
                    }
                    Text {
                        text: root.status-text;
                        color: #a1a1aa;
                        font-size: 12px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // 2. BARRA DE MÓDULOS CON AUTO-AJUSTE
        Rectangle {
            height: 50px;
            background: #09090b;
            border-radius: 8px;
            border-width: 1px;
            border-color: #18181b;

            HorizontalLayout {
                padding: 6px;
                spacing: 8px;

                TacticalButton {
                    text: "[F1] VISITAS";
                    h-stretch: 1;
                    active: root.active-module == "visita";
                    clicked => { root.quick-action("visita"); }
                }
                TacticalButton {
                    text: "[F2] VEHÍCULOS";
                    h-stretch: 1;
                    active: root.active-module == "vehiculo";
                    clicked => { root.quick-action("vehiculo"); }
                }
                TacticalButton {
                    text: "[F3] PAQUETERÍA";
                    h-stretch: 1;
                    active: root.active-module == "paquete";
                    clicked => { root.quick-action("paquete"); }
                }
                TacticalButton {
                    text: "[F4] UNIDADES & PREDIOS";
                    h-stretch: 1;
                    active: root.active-module == "unidades";
                    clicked => { root.quick-action("unidades"); }
                }
                TacticalButton {
                    text: "[F5] MINUTA & NOVEDADES";
                    h-stretch: 1;
                    active: root.active-module == "minuta";
                    clicked => { root.quick-action("minuta"); }
                }
            }
        }

        // 3. CUERPO PRINCIPAL: GESTIÓN DE UNIDADES
        HorizontalLayout {
            spacing: 12px;

            // PANEL IZQUIERDO: TORRES Y BLOQUES
            Rectangle {
                width: 260px;
                background: #09090b;
                border-radius: 8px;
                border-width: 1px;
                border-color: #18181b;

                VerticalLayout {
                    padding: 14px;
                    spacing: 10px;

                    HorizontalLayout {
                        alignment: space-between;
                        Text {
                            text: "TORRES / BLOQUES";
                            color: #71717a;
                            font-size: 12px;
                            font-weight: 800;
                            vertical-alignment: center;
                        }
                    }

                    Rectangle { height: 1px; background: #18181b; }

                    for tower in root.towers: Rectangle {
                        height: 48px;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: root.selected-tower == tower.name ? #38bdf8 : #18181b;
                        background: root.selected-tower == tower.name ? #111827 : (tower-touch.has-hover ? #141417 : #050507);

                        tower-touch := TouchArea {
                            clicked => {
                                root.selected-tower = tower.name;
                                root.select-tower(tower.name);
                            }
                        }

                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            alignment: space-between;

                            Text {
                                text: tower.name;
                                color: root.selected-tower == tower.name ? #38bdf8 : #f4f4f5;
                                font-size: 14px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }

                            Rectangle {
                                width: 68px;
                                height: 22px;
                                border-radius: 11px;
                                background: #18181b;
                                y: 13px;

                                Text {
                                    text: tower.unit_count + " aptos";
                                    color: #a1a1aa;
                                    font-size: 11px;
                                    font-weight: 600;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    Rectangle { height: 10px; }

                    TacticalButton {
                        text: "+ NUEVA TORRE / BLOQUE";
                        h-stretch: 1;
                        clicked => {
                            root.status-text = "Iniciando creación de nueva torre...";
                        }
                    }
                }
            }

            // PANEL DERECHO: DIRECTORIO DE INMUEBLES
            Rectangle {
                background: #09090b;
                border-radius: 8px;
                border-width: 1px;
                border-color: #18181b;

                VerticalLayout {
                    padding: 16px;
                    spacing: 12px;

                    // Cabecera superior del panel de inmuebles
                    HorizontalLayout {
                        alignment: space-between;

                        HorizontalLayout {
                            spacing: 12px;
                            Text {
                                text: root.selected-tower;
                                color: #ffffff;
                                font-size: 18px;
                                font-weight: 800;
                                vertical-alignment: center;
                            }
                            Text {
                                text: "•  Directorio de Inmuebles Registrados";
                                color: #71717a;
                                font-size: 13px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }

                        // BOTÓN QUE ABRE EL MODAL
                        TacticalButton {
                            text: "+ NUEVO INMUEBLE [MODAL]";
                            primary: true;
                            clicked => {
                                root.show-modal = true;
                            }
                        }
                    }

                    Rectangle { height: 1px; background: #18181b; }

                    // TABLA DE INMUEBLES LIMPIA Y ESPACIOSA
                    VerticalLayout {
                        spacing: 3px;

                        // Cabecera de la Tabla
                        Rectangle {
                            height: 36px;
                            background: #000000;
                            border-radius: 4px;
                            border-width: 1px;
                            border-color: #18181b;

                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;

                                Text { text: "INMUEBLE"; width: 110px; color: #71717a; font-size: 11px; font-weight: 800; vertical-alignment: center; }
                                Text { text: "TIPO"; width: 120px; color: #71717a; font-size: 11px; font-weight: 800; vertical-alignment: center; }
                                Text { text: "CITÓFONO / EXT."; width: 140px; color: #71717a; font-size: 11px; font-weight: 800; vertical-alignment: center; }
                                Text { text: "CELULAR GARITA"; width: 140px; color: #71717a; font-size: 11px; font-weight: 800; vertical-alignment: center; }
                                Text { text: "TEL. FIJO"; width: 120px; color: #71717a; font-size: 11px; font-weight: 800; vertical-alignment: center; }
                                Text { text: "PARQUEADEROS PRIVADOS"; color: #71717a; font-size: 11px; font-weight: 800; vertical-alignment: center; }
                            }
                        }

                        // Filas de Inmuebles
                        for unit in root.units: Rectangle {
                            height: 42px;
                            background: #050507;
                            border-radius: 4px;
                            border-width: 1px;
                            border-color: #141417;

                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;

                                Text { text: unit.unit-number; width: 110px; color: #ffffff; font-size: 13px; font-weight: 800; vertical-alignment: center; }
                                Text { text: unit.unit-type; width: 120px; color: #a1a1aa; font-size: 13px; vertical-alignment: center; }
                                
                                HorizontalLayout {
                                    width: 140px;
                                    spacing: 6px;
                                    Rectangle {
                                        width: 6px;
                                        height: 6px;
                                        border-radius: 3px;
                                        background: unit.intercom == "Sin citófono" ? #ef4444 : #22c55e;
                                        y: 18px;
                                    }
                                    Text {
                                        text: unit.intercom;
                                        color: unit.intercom == "Sin citófono" ? #f87171 : #4ade80;
                                        font-size: 12px;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                    }
                                }

                                Text { text: unit.mobile; width: 140px; color: #e4e4e7; font-size: 13px; font-weight: 600; vertical-alignment: center; }
                                Text { text: unit.landline; width: 120px; color: #71717a; font-size: 13px; vertical-alignment: center; }
                                
                                Text {
                                    text: unit.parking;
                                    color: unit.parking == "Sin celda" ? #52525b : #38bdf8;
                                    font-size: 13px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            }
        }

        // 4. FOOTER TÁCTICO INFERIOR
        HorizontalLayout {
            alignment: space-between;
            Text {
                text: "ATAJOS: [F4] UNIDADES | [INS] AGREGAR PREDIO | [ESC] CERRAR | CLIC EN TORRE PARA FILTRAR";
                color: #52525b;
                font-size: 11px;
                font-weight: 700;
            }
            Text {
                text: "MAMORI v0.1.0 — TRUE BLACK & MODAL OVERLAY (SLINT / RUST)";
                color: #52525b;
                font-size: 11px;
                font-weight: 700;
            }
        }
    }

    // ========================================================================
    // CAPA SUPERIOR: VENTANA MODAL FLOTANTE (OVERLAY TÁCTICO)
    // ========================================================================
    if (root.show-modal): Rectangle {
        // Fondo semi-transparente que oscurece el resto de la pantalla
        background: #000000d9; // 85% opacidad negra
        width: 100%;
        height: 100%;

        // Clic en el fondo oscuro para bloquear clics a la vista de abajo
        TouchArea {
            clicked => { /* Absorbe clics externos */ }
        }

        // TARJETA CENTRAL DE LA VENTANA MODAL
        Rectangle {
            width: 620px;
            height: 480px;
            background: #09090b; // Negro profundo
            border-radius: 12px;
            border-width: 1px;
            border-color: #27272a; // Borde gris sutil elegante
            clip: true;

            VerticalLayout {
                padding: 24px;
                spacing: 16px;

                // CABECERA DEL MODAL
                HorizontalLayout {
                    alignment: space-between;

                    VerticalLayout {
                        spacing: 2px;
                        Text {
                            text: "REGISTRAR NUEVO INMUEBLE";
                            color: #ffffff;
                            font-size: 17px;
                            font-weight: 900;
                        }
                        Text {
                            text: "Asignando predio en: " + root.selected-tower;
                            color: #38bdf8;
                            font-size: 13px;
                            font-weight: 600;
                        }
                    }

                    // Botón cerrar modal [X]
                    Rectangle {
                        width: 32px;
                        height: 32px;
                        border-radius: 16px;
                        background: close-touch.has-hover ? #27272a : #18181b;

                        close-touch := TouchArea {
                            clicked => { root.show-modal = false; }
                        }

                        Text {
                            text: "✕";
                            color: #a1a1aa;
                            font-size: 14px;
                            font-weight: 800;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }

                Rectangle { height: 1px; background: #18181b; }

                // CAMPOS DEL FORMULARIO MODAL
                VerticalLayout {
                    spacing: 12px;

                    // Fila 1: Número de Predio y Tipo
                    HorizontalLayout {
                        spacing: 12px;
                        VerticalLayout {
                            spacing: 5px;
                            Text { text: "NÚMERO DE INMUEBLE / PREDIO:"; color: #a1a1aa; font-size: 11px; font-weight: 800; }
                            LineEdit { text <=> root.form-unit-number; placeholder-text: "Ej: 301, 102A, Casa 15"; }
                        }
                        VerticalLayout {
                            spacing: 5px;
                            Text { text: "CITÓFONO / EXTENSIÓN:"; color: #a1a1aa; font-size: 11px; font-weight: 800; }
                            LineEdit { text <=> root.form-intercom; placeholder-text: "Ej: Ext. 301 o 'Sin citófono'"; }
                        }
                    }

                    // Fila 2: Celular principal y Teléfono Fijo
                    HorizontalLayout {
                        spacing: 12px;
                        VerticalLayout {
                            spacing: 5px;
                            Text { text: "TELÉFONO CELULAR (CONTACTO GARITA):"; color: #a1a1aa; font-size: 11px; font-weight: 800; }
                            LineEdit { text <=> root.form-mobile; placeholder-text: "Ej: 300 123 4567"; }
                        }
                        VerticalLayout {
                            spacing: 5px;
                            Text { text: "TELÉFONO FIJO (OPCIONAL):"; color: #a1a1aa; font-size: 11px; font-weight: 800; }
                            LineEdit { text <=> root.form-landline; placeholder-text: "Ej: (604) 444 0000"; }
                        }
                    }

                    // Fila 3: Parqueaderos Privados
                    VerticalLayout {
                        spacing: 5px;
                        Text { text: "PARQUEADEROS PRIVADOS ASIGNADOS:"; color: #a1a1aa; font-size: 11px; font-weight: 800; }
                        LineEdit { text <=> root.form-parking; placeholder-text: "Ej: P-301, Celda Moto M-02 (Separados por coma)"; }
                    }
                }

                Rectangle { height: 6px; }
                Rectangle { height: 1px; background: #18181b; }

                // BOTONES DE ACCIÓN INFERIORES DEL MODAL
                HorizontalLayout {
                    alignment: end;
                    spacing: 12px;

                    TacticalButton {
                        text: "CANCELAR [ESC]";
                        font-size: 12px;
                        clicked => {
                            root.show-modal = false;
                        }
                    }

                    TacticalButton {
                        text: "💾 GUARDAR INMUEBLE";
                        primary: true;
                        font-size: 13px;
                        clicked => {
                            root.save-unit();
                            root.show-modal = false;
                        }
                    }
                }
            }
        }
    }
}
